{
  "name": "@inshapardaz/qari",
  "version": "0.2.4",
  "description": "Universal Ebook Reader - Framework-agnostic ebook reading component",
  "repository": {
    "type": "git",
    "url": "https://github.com/inshapardaz/qari"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "vite serve demo",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-extensions.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "markdown-it": "^14.2.0",
    "nspell": "^2.1.5",
    "pdfjs-dist": "^4.10.38",
    "sqids": "^0.3.0"
  },
  "peerDependencies": {
    "@mantine/core": "^8.0.0 || ^9.0.0",
    "@mantine/hooks": "^8.0.0 || ^9.0.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "^14.1.2",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.1",
    "@vue/runtime-core": "^3.5.39",
    "@vue/test-utils": "^2.4.11",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^3.15.1",
    "jsdom": "^24.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "vue": "^3.5.39"
  }
}
