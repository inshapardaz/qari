اُلفتِ ظاہری ۔ دکھاوے کی محبت ۔ جھوٹی محبتمُنّہ  دیکھے کی باتیں
اِسمِ مؤنّث
ظاہری باتیں ۔ دکھاوے کی باتیں ۔ اوپری باتیں ۔مُنّہ  دیکھے کی پریت 
اِسمِ مؤنّث
دیکھو(مُنّہ  دیکھے کی اُلفت)مُنّہ  دیکھے کی چاہ 
اِسمِ مؤنّث
دیکھو(مُنّہ  دیکھے کی اُلفت)مُنّہ  دے کر بات کرنا 
فعل متعدّی
رُخ دے کر  بولنا ۔ التفات سے بولنا ۔مُنّہ  ذرا سا نکل آنا
فِعل لازِم
چہرہ سُت جانا ۔ خوف یا دہشت  کے مارے مُنّہ  دُبلا پڑجانا ۔مُنّہ  رکھنا
فِعل لازِم
پاس رکھنا ۔ لحاظ رکھنا ۔ رُخ رکھنا ۔ میل ملاپ رکھنا ۔مُنّہ  زبانی 
صِفت
زبانی ۔ بِلا تحریر ۔  نوک زباں ۔ حفظ ۔مُنّہ  زرد ہوجانا 
فِعل لازِم
خوف یا دہشت خواہ ہر اس سے چہرے کا رنگ پلٹ جانا ۔ مُنّہ  فق ہوجانا ْمُنّہ  زور
صِفت
مُنّہ  پھٹ  ۔ مُنّہ  کا پھوڑا ۔ بدلگام ۔ چُپ نہ رہنے والا ۔  بکّی ۔ بکواس  ۔ سرکش گھوڑا ۔مُنّہ  زوری 
اِسمِ مؤنّث
بدزبانی ۔ بدلگامی ۔ سخت کلامی ۔مُنّہ  زوری کرنا
فعل متعدّی
بدزبانی کرنا  ۔ بدلگامی کرنا ۔ سخت کلامی ۔مُنّہ  زہر ہوجانا
فِعل لازِم
مُنّہ  کڑوا یا تلخ ہوجانا ۔مُنّہ  سُجانا
فعل متعدّی
مُنّہ  پُھلانا ۔ اُداس ہونا  ناراض ہونا ۔، غمگین ہونا ۔مُنّہ  سُرخ ہوجانا
فِعل لازِم
غصّے یا غضب سے چہرے کا لال ہوجانا ۔مُنّہ  سفید پڑجانا
فِعل لازِم
خوف یا دہشت  یا ناامیدی سے مُنّہ  کی رنگت پلٹ جانا ۔ خوف چھا جانامُنّہ  سنبھالنا
فعل متعدّی
بیہودہ گوئی سے زبان روکنامُنّہ  سنبھالو
محاورہ
زبان روکو ۔ سوچ سمجھ کر زبان سے الفاظ نکالو ۔مُنّہ  سُوئی پیٹ کوئی 
کہاوت
مُنّہ  ذرا سا پیٹ بڑا سامُنّہ  سوکھنا
فِعل لازِم
خوف یا دہشت کے باعث مُنّہ  کا خُشک ہوجانا ۔ دُبلا ہونا ۔ لاغر ہونا ۔مُنّہ  سکوڑنا
فِعل لازِم
ناک بھوں چڑھانا ۔ ناراضگی ظاہر کرنا ۔مُنّہ  سُکڑ جانا 
فِعل لازِم
چہرہ سُست ہوجانا ۔ ناراضگی ظاہر کرنا ۔مُنّہ  سُکیڑنا
فِعل لازِم
مُنّہ  بنانا ۔ مُنّہ  ٹیڑھا کرنا ۔ تیوری چڑھانا ۔ ناراض ہونا ۔مُنّہ  سی دینا 
فعل متعدّی
مُنّہ  بند کر دینا ۔ چُپ کر دینا ۔ بالکل خاموش کر دینا ۔مُنّہ  سی لینا 
فِعل لازِم
مُنّہ  بند کر لینا ۔ چُپ سادھ لینا ۔ خاموشی اختیار کر لینا ،۔مُنّہ  سیا جانا
فِعل لازِم
مُنّہ  بند کیا جانا ۔ خاموش کیا جانا ۔مُنّہ  سیاہ کرنا
فعل متعدّی
مُنّہ  کالا کرنا ۔ خضاب لگانا ۔ کلنگ لگانا ۔ کلف لگانا ۔مُنّہ  سینا
فعل متعدّی
مُنّہ  بند کرنا ۔ مُنّہ  پر مہر یا  قفل لگانا  ۔مُنّہ  سے اگلنا
فعل متعدّی
مُنّہ  سے نکالنا ۔ مُنّہ  میں سے باہر لانا ۔مُنّہ  سے بات لپکنا
فعل متعدّی
جس بات کے کہنے کا دوسرا ارادہ کرے آپ اُس سے پہلے کہ دیں ۔ کسی کے دل کی کہنا ۔مُنّہ  سے بات نکلنا
فِعل لازِم
ذکر کیا جانا ،۔ زبان پر بات آنا ۔مُنّہ  سے بات نہ نکلنا
فِعل لازِم
دہشت یا خوف سے بول نہ سکنا ۔مُنّہ  سے بس کرنا
فعل متعدّی
زبان سے کافی ہے کہنا ۔ زبان سے انکار کرنا ۔مُنّہ  سے بولنا
فِعل لازِم
زبان سے بات کرنا ،۔ جواب دینا ۔مُنّہ  سے بولو سر سے کھیلو
محاورہ
بات چیت کرو خاموش نہ رہو ۔مُنّہ  سے بولے نہ سرے کھیلے 
محاورہ
بالکل خاموش اور ساکت رہے ۔مُنّہ  سے بھاپ نکالنا
فِعل لازِم
مُنّہ  سے اُف کرنا ۔ زبان سے اُف نکالنا ۔مُنّہ  سے بھاپ نہ نکالنا
فِعل لازِم
دم بخود رہنا ۔ چُپ ناندھنا ۔ خاموش رہنا ۔ اُف نہ کرنا ۔مُنّہ  سے تو پھوٹو
محاورہ
کچھ تو بولو ۔ کچھ تو کہو ۔ ہاں یا نہ کرومُنّہ  سے تو کہو
محاورہ
بیان تو کرو ،۔ بات تو کرو ۔مُنّہ  سے دودھ ٹپکنا
فِعل لازِم
نہایت شیر خوار اور بچہ ہونا ۔ نادان اور بے سمجھ ہونا ۔مُنّہ  سے دودھ کی بو آنا 
فِعل لازِم
کم عقل اور بے لیاقت ہونا ۔ نادان اور بچہ ہونامُنّہ  سے دودھ کی بو نہ  جانا 
فِعل لازِم
شیرخوارگی کا زمانہ موجود ہونا ۔ دودھ پینے کا زمانہ برقرار رہنا ۔مُنّہ  سے رال ٹپکی پڑنا 
فِعل لازِم
کسی چیز کے خواہش  و رغبت کے سبب مُنّہ  میں پانی بھر آنا ۔ نہایت جی للچانا ۔مُنّہ  سے سُنا چاہتے ہو 
محاورہ
کیا گالیاں کھانے اور بُرا بھلا سُننے کو جی چاہتا ہے ۔مُنّہ  سے لعل اُگلنا
فِعل لازِم
نہایت خوش  کلام اور خوش گفتار ہونا ۔مُنّہ  سے لینا 
فِعل لازِم
دوسرے کے دل میں آئی ہوئی بات کہدینا ۔ دل کی سی کہنامُنّہ  سے مُنّہ  ملانا 
فعل متعدّی
چومہ چاٹی کرنا ۔ دانہ بدلی کرنا ۔ ہمکلام ہونا ۔ زبان سے زبان ملانا ۔مُنّہ  سے مہابا ہے 
محاورہ
یعنی خاطر سے خاطر اور محبت سے محبت ہےمُنّہ  سے نکالنا 
فعل متعدّی
زبان پر لانا ۔ بولنامُنّہ  سے پھول جھڑنا
فِعل لازِم
خوش تقریر اور خوش گفتار ہونا ۔ رنگیں سخن اور شیریں کلام ہونا ۔مُنّہ  سے پھوٹنا 
فِعل لازِم
جواب دینا ۔ زبان سے کچھ کہنا ۔ مُنّہ  کا قفل کھولنا ۔مُنّہ  سے کلیجہ نکل پڑنا 
فِعل لازِم
دم اُلٹ جانا ۔ دل گھبرا جانا ۔ جی اکتا جانا ۔مُنّہ  فق
صِفت
بے حواس ۔ بے اوسان ۔ حواس باختہ ۔مُنّہ  فق ہوجانا 
فِعل لازِم
مُنّہ  سفید پڑجانا  ۔ حواس باختہ ہو جانا ۔ گھبرا جانا ، رُعب چھا جانا ۔ بے وسان ہوجانا ۔مُنّہ  پر آئی بات
اِسمِ مؤنّث
وہ بات جو نکل کر ہونٹوں تک پہنچ گئی ہو   ۔ زبان پر آئی ہوئی بات ۔مُنّہ  پر لانا 
فعل متعدّی
زبان پر   رکھنا ۔ زبان سے کہنا ۔مُنّہ  پر مہر کر دینا
فعل متعدّی
مُنّہ سی دینا ۔ مُنّہ بند کردینا ۔ مُنّہ کو قفل لگا دینا ۔ بولنے سے روک دینا ۔ خاموش کرنا ۔ ساکت کرنامُنّہ  پکڑنا
فعل متعدّی
مُنّہ بند کرنا ۔ بولنے سے روکنا ۔ بولنے نہ دینا ۔مُنّہ  چلانا
فعل متعدّی
مُنّہ ہلانا ۔ مُنّہ کو حرکت دینا ۔ جُگائی کرنا ۔ گھوڑے کا کاٹنا ۔ بدزبانی کرنا ۔ گالیاں دینا ۔مُنّہ  چلنا
فِعل لازِم
مُنّہ ہلنا ۔ مُنّہ کا گردش کرنا ۔ مُنّہ کا متحرک ہونا ۔مُنّہ  چُور
صِفت
لجالو ۔ شرمالو ۔ حیامند ۔ شرمشارمُنّہ  چوم لینا
فعل متعدّی
بوسہ لے لینا ۔ چوما لے لینا ۔ نہایت سرہانا ۔ کسی بات پر قربان ہوجانا ۔مُنّہ  چوم کے چھوڑ دینا 
فعل متعدّی
ذلیل و شرمندہ کر کے چھوڑ دینا ۔ کام نکال کے ٹرخا دینا ۔مُنّہ  چومنا
فِعل لازِم
بوسہ لینا ۔ چوما لینا ۔ پیار لینا ۔ خوشی میں آ کر پیار کرنا ۔ گلے لگانا ۔مُنّہ  چڑھانا
فعل متعدّی
کسی کو گستاخ اور بے ادب بنانا  ۔ سر چڑھانا ۔ مُنّہ بگاڑنا ۔ نا پسند ظاہر کرنے کی علامت ظاہر کرنا ۔مُنّہ  چڑھنا 
فِعل لازِم
مُنّہ لگنا ۔ رفیق ہونا ۔ منظورِ نظر ہونا ۔ گُستاخ بننا ۔ بے ادب ہونا ۔ مقابل ہونا ۔ سامنے پڑنا ۔ ہمسری کا دعوے کرنا ۔ زبان پر چڑھنا ،۔ زبان آشنا ہونا ۔ چہرے پر نمایاں ہونا ۔مُنّہ  چِکنا پیٹ خالی
محاورہ
مُنّہ پر امیری ہے پیٹ میں چوہے قلابازیاں کھا رہے ہیں ۔مُنّہ  چُھوائی
اِسمِ مؤنّث
ظاہری طلب ۔ وہ طلب یا مانگ جو دل سے نہ ہو ۔ تواضع سمر قندیمُنّہ  چُھوانا
فعل متعدّی
اوپری دل سے کہنا ۔ برائے نام کہنا ۔مُنّہ  چھونا
فعل متعدّی
برائے نام کہنا ۔ جھوٹوں کہنا ۔ اوپری دل سے بلاوا دینا ۔ ظاہری طور پر کہنا ۔ ذرا بات کرنا ۔مُنّہ  چھوٹا اور بات بڑی 
کہاوت
حوصلہ سے بڑھ کر بات کرنا ،۔مُنّہ  چُھٹ
صِفت
دریدہ دہن ۔ بے لگام ۔مُنّہ  چُھپانا
فعل متعدّی
مُنّہ  پوشیدہ کرنا   ۔ چہرہ سامنے نہ  کرنا ۔ پردہ کرنا ۔ نقاب   ڈالنا ۔مُنّہ  چھیتنا
فعل متعدّی
مُنّہ  کو طمانچوں سے زخمی کرنا ۔ تھپڑ مارنا ۔مُنّہ  ڈالنا
فعل متعدّی
کسی جانور کا کسی برتن میں مُنّہ  داخل کرنا ۔ حملہ  کرنا ۔مُنّہ  ڈھانپ ڈھانپ کر رونا
فِعل لازِم
نہایت گریہ کرنا ۔مُنّہ  ڈھانپنا
فِعل لازِم
مُنّہ  پر کپڑا ڈالنا ۔ مُنّہ  پر رومال ڈالنا ۔مُنّہ  ڈھانک ڈھانک   رونا
فِعل لازِم
مُنّہ  پر کپڑا ڈال ڈال کر رونا ۔مُنّہ  ڈھانک ڈھانک کر رونا 
فِعل لازِم
مُنّہ  پر رومال یا کپڑا رکھ کر زاروقطار رونا ۔مُنّہ  ڈھانک کر رونا
فِعل لازِم
مُنّہ  پر رومال ڈال کر خُوب رونا ۔ یکسُو ہو کر رونا ۔ زارزاررونامُنّہ  ڈھانکنا
فِعل لازِم
مُنّہ  چھپانا ۔ مُنّہ  پر پردہ ڈالنا ۔ نوحہ کرنا ۔ رونا ۔ ماتم کرنا ۔ ماتم پرسی کرنا ۔مُنّہ  ڈھک ڈھک کر رونا
فِعل لازِم
عورتوں کی طرح زار زار رونا ۔ زاروقطار رونا ۔ خُوب رونامُنّہ  ڈھک کر رونا
فِعل لازِم
دیکھو(مُنّہ  ڈھانک کر رونا)مُنّہ  کا رنگ فق ہوجانا 
فِعل لازِم
دیکھو(مُنّہ  فق ہو جانا)مُنّہ  کا مُنّہ  میں ہاتھ کا ہاتھ میں نوالہ رہ گیا 
کہاوت
خبر بد کے سُنتے ہی اوسان نہ رہے حیرت کا عالم چھا گیا ۔مُنّہ  کا میٹھا 
صِفت
زبان کا میٹھا ۔ باتوں کا میٹھا ۔مُنّہ  کا میٹھا پیٹ کا کھوٹا 
صِفت
ظاہر میں دوست باطن میں دشمن ۔مُنّہ  کا نوالہ 
اسمِ مُذکّرُ
لُقمہ دہن ۔ گِراس ۔ ایک خفیف اور ادنٰے کام ۔مُنّہ  کا نوالہ سمجھنا
فِعل لازِم
ایک ادنٰے اور آسان کام سمجھنا ۔مُنّہ  کا نوالہ ہوجانا
فِعل لازِم
مُنّہ میں چلا جانا  ۔ مُنّہ میں سما جانا ۔مُنّہ  کا نور اُڑ جانا 
فِعل لازِم
چہرے کی رونق اور آب و تاب کا جاتا رہنا ،مُنّہ  کا پھوڑا 
صِفت
بدلگام ۔ بد زبانمُنّہ  کا کچّا 
صِفت
نرم  مُنّہ  کا گھوڑا ۔ اصیل مرغ ۔ زبان کا کچّا ۔مُنّہ  کا کڑا
صِفت
مُنّہ  کا سخت ۔ مُنّہ  کا مضبوط ۔مُنّہ  کالا 
صِفت
بدنام ۔ رسوا ۔ بدافعال  ۔مُنّہ  کالا کر

مُنّہ نہ دکھلا ۔ دفع ہو ۔ رستہ لے  ۔مُنّہ  کالا کرنا
فعل متعدّی
مُنّہ کو سیاہی لگانا ، بدفعلی کرنا ۔ زنا کرنا ۔مُنّہ  کالا ہونا 
فِعل لازِم
مُنّہ کو سیاہی لگنا ۔ کلنگ لگنا ۔ بدنامی ہونا ۔مُنّہ  کرنا 
فعل متعدّی
سُوراخ کرنا ۔ چھید کرنا ۔ پاس کرنا ۔ لحاظ کرنا ۔ لالچ کرنا ۔ لابھ کرنا ۔مُنّہ  کِلنا
فِعل لازِم
مُنّہ بند ہونا ۔ کسی کے برخلاف کہنے سے زبان رک جانا ،مُنّہ  کو باندھنا
فعل متعدّی
مُنّہ کو کسی چیز سے جکڑنا ۔مُنّہ  کو بنانا 
فِعل لازِم
دیکھو(مُنّہ بنانا )مُنّہ  کو بند کرنا 
فعل متعدّی
زبان روکنا ۔ زبان بند کرنا ۔مُنّہ  کو بنوانا 
فِعل لازِم
اپنے کو کسی کام کے لائق اور سزادار کرنا ۔مُنّہ  کو جوڑنا
فعل متعدّی
دیکھو(مُنّہ جوڑنا)مُنّہ  کو جگر آنا 
فِعل لازِم
دم اُلٹنا ۔ جی گھبرانا ۔ بوکھلانا ۔مُنّہ  کو جھلسا لگانا 
فعل متعدّی
مُنّہ کو آگ لگانا  ۔مطلب نہ رکھنا ۔مُنّہ  کو خون لگنا 
فِعل لازِم
خون کا مزہ پڑنا ۔ خون کی چاٹ لگنا ۔مُنّہ  کو دکھا سکنا
فِعل لازِم
مُنّہ  سامنے کر سکنا ۔ چہرہ مقابل کرنے  قابل ہونا ۔مُنّہ  کو سنبھالنا
فعل متعدّی
زبان کو خلافِ تہذیب  بوتوں سے روکنا ۔ بدزبانی سے باز آنا ۔مُنّہ  کو قفل دینا
فعل متعدّی
مُنّہ کو بند کرنا ۔ مُنّہ کو مہر لگا دینا ۔ سکوت اختیار کرنا ۔مُنّہ  کو لگام دو
محاورہ
زبان سنبھال کر بولو ۔ بدزبانی سے باز آؤمُنّہ  کو لگنا
فِعل لازِم
زبان کو چاٹ پڑنا ۔ مزہ پڑنا ۔ چسکا پڑنا ۔مُنّہ  کو لہُو یا خون لگنا
فِعل لازِم
شکار کا مزہ پڑنا ۔ خُون کی چاٹ لگنامُنّہ  کو پھیر لینا 
فِعل لازِم
اعراض کر لینا ۔ رُوکشی کرنا ۔ روگردانی کرنامُنّہ  کو کالک لگانا
فعل متعدّی
کلنگ لگانا ۔ رسوا کرنا ۔ بدنام کرنامُنّہ  کو کالک لگنا 
فِعل لازِم
رُوسیاہی حاصل ہونا ۔ کلنگ لگنا ۔ رسوائی ہونا ،مُنّہ  کو کلیجہ آنا
فِعل لازِم
غم غصّہ کا ضبط نہ ہونا ۔ دم نکلنے کو ہونا ۔مُنّہ  ہی مُنّہ مارے اور توبہ توبہ پکارے 
کہاوت
اپنا الزام مظلوم کے سر تھوپے ۔مُنہ اُترنا جانا ۔ 
فِعل لازِم
مُنّہ  نکل آنا ۔ چہرہ سُست ہونا ۔ چہرہ بے رونق ہوجانا ۔ رُخ کا پُزمردہ ہوجانا ۔ چہرے سے رنج اور ملال کے آثار ظاہر ہونا ۔ لاغر اور دُبلا ہوجانا ۔مِنّہ آنا
فِعل لازِم
بارش آنا ۔ پانی پڑنے لگنا ۔مُنہ اُٹھ جانا 
فِعل لازِم
رُخ ہوجانا ۔مُنہ اپنا سا لیکر رہ جانا 
فِعل لازِم
شرمندہ ہو کر رہ جانا ۔ مذامت اُٹھانا ۔ کسی بات کے منظور نہ ہونے  سے  شرمندگی اُٹھانا ۔مُنہ اپنا سا لیکر پھر جانا
فِعل لازِم
شرمندہ ہو کر چلا جانا ۔ مذامت  اُٹھا کر جانا ۔مُنہ اکھری 
صِفت
زبانی ۔ مُنّہ زبانی ۔ غیر تحریری ۔مُنّہ بانا 
فِعل لازِم
مُنّہ  کھولنا ۔ مُنّہ  پھاڑنا ۔ جمائی لینا ۔ اپنی بےوقوفی پر ہنس پڑنا ۔مِنّہ برسنا
فِعل لازِم
پانی پڑنا ۔ بارش ہونامُنّہ بھر دینا
فعل متعدّی
مُنّہ کا پُر کر دینا  ۔ رشوت دیدینا ۔مُنّہ بھر کے 
تابع فعل
لبالب ۔ لبریز ۔ بھرپُور ۔ نہایت ۔مُنّہ بھر کے کوسنا
فعل متعدّی
خاطر خواہ بد دعا دینا ۔ بے دردی سے کوسنا ،۔مُنّہ بھر کے گالی دینا
فعل متعدّی
فحش  بکنا ۔ قابلِ شرم  دُشنام  دینامُنّہ بھرائی 
اِسمِ مؤنّث
دہاں بندی ۔ بُرائی یا  بدی  یا عیب  سے مُنّہ سی دینے والی چیز ۔ رشوت ۔مُنّہ بھرائی دینا
فعل متعدّی
رشوت دینا ۔ گھونس دینا ۔ لُقمہ دینا ۔مُنّہ بھرنا
فعل متعدّی
مُنہ پُر کرنا ۔ مُنّہ میں لقمہ دینا ، رشوت دینا ۔ رشوت دے کر چُپ کرنا ۔مُنّہ تمتمانا
فِعل لازِم
بُخار یا غُصّے کے باعث چہرے کا سُرخ ہوجانا ۔مُنّہ تو دیکھو
محاورہ
یہ قابلیت تو پیدا کر لو ۔ دل میں قائل  تو ہو لومُنّہ تو دیکھیئے
محاورہ
دیکھو(مُنّہ تو دیکھو)مُنّہ توڑ کے جواب دینا
فعل متعدّی
دنداں شکن جواب دینا ۔ بے باکانہ جواب دینا ۔ بے لاگ جواب دینامُنّہ تک آنا 
فِعل لازِم
لب تک آنا ۔ زبان تک آنا ۔ لبریز کرنا ۔مُنّہ تک بھرنا
فعل متعدّی
لبالب پُر کرنا ۔ گلے تک اٹانا ۔ پُر ہونا ۔مُنّہ تک جگر آنا 
فِعل لازِم
دم التنا ۔ دم گھبرانا ۔مُنّہ تکنا
فِعل لازِم
چہرے کی طرف  نظر کرنا ۔ صُورت دیکھنا ۔ مُنّہ کی طرف گھورنامُنّہ تُھتھانا
فِعل لازِم
مُنّہ سُجانا ۔ تیوری چڑھانا ۔ مُنّہ پُھلانا ۔مُنّہ تھکنا
فِعل لازِم
مُنّہ دُکھنا ۔ مُنّہ کو تکلیف ہونا ۔مُنّہ جوڑنا
فِعل لازِم
کُھسر پُھسر کرنا ۔ کانا پھوسی کرنا ۔ چپکے چُپکے  چرچا کرنا ۔ ذکر اذکار کرنا ۔مُنّہ جُھلسنا
فعل متعدّی
مُنّہ کو لُو کا لگانا ۔ مُنّہ کو جھلسا دینا ۔ مُنّہ کو جلانا ۔ مُنّہ کو جلا کر سیاہ کرنا ۔مُنّہ جُھٹالنا
فعل متعدّی
برائے نام کھانا ۔نام گنانے کو کھانا ۔ کھانا کھانے  کا نام کرنا  ۔مُنّہ جھٹک جانا 
فِعل لازِم
مُنّہ نکل جانا ۔ مُنّہ اُتر جانا ۔ چہرہ سُست ہوجانا ۔ دُبلا پڑجانا ۔مُنّہ زبان نہ ہونا 
فِعل لازِم
گونگا ہونا ۔ خاموش ہونا ۔ بولنے کے قابل نہ ہونا ۔مُنّہ لال کرنا
فعل متعدّی
پان یا کسی اور چیز سے مُنّہ سُرخ کرنا ۔ مُنّہ پر تھپڑ لگانا ۔مُنّہ لال ہوجانا 
فِعل لازِم
غصّے غضب یا تپش سے چہرہ لال ہوجانا ۔مُنّہ لال ہونا 
فِعل لازِم
چہرہ سُرخ ہونا ۔ تھپڑ اور طمانچوں کے مارے چہرہ سُرخ ہوجانا ۔مُنّہ لپیٹ کر پڑنا 
فِعل لازِم
رنجیدہ ہو کر لیٹ جانا  ۔ غمگین ہو کر پڑجانا ۔مُنّہ لگانا
فعل متعدّی
مُنّہ سے چھونا ۔ مُنّہ سے مس کرنا ۔ مُنّہ سے بھڑانا ۔ مُنّہ لگا کر پانی پینا ۔ مصاحب بنانا ۔ ہمراز بنانا ۔ ہم صحبت بنانا ۔ دوست بنانا ۔ توجہ کرنا ۔ عنایت اور مہربانی سے پیش آنا ۔ حمایت کرنا ۔ خیال میں لانا ۔ متوجہ ہونا ۔ عزّت سے پیش آنا ۔مُنّہ لگنا
فِعل لازِم
مُنّہ سے مَس ہونا ۔ مُنّہ سے چھوا جانا ۔ قُرب حاصل ہونا ۔ ہم نشین ہونا ۔ عزّت سے پیش آنا ۔مُنّہ لے کے رہ جانا 
فِعل لازِم
انحطاط مرتبہ پر خیال کر کے حالتِ انفعال میں خاموش رہ جانا ۔مُنّہ لے کے پھر جانا 
فِعل لازِم
بھروسے کے خلاف  مایوس جانا ۔ انفعال میں خاموش ہوجانا ۔مُنّہ مارنا
فعل متعدّی
ڈسنا ۔ کاٹنا ۔ ڈنک مارنا ۔ شکار کو مُنّہ  سے پکرنا ۔ گھوڑے کا کاٹ کھانے کو مُنّہ چلانا ۔ مُنّہ بند کر دینا ۔ کھانے سے روکنا ۔ جلد جلد کھانا ۔ طنز کی بات کہنا ۔ نوک یا دھاڑ کو رگڑ دینا ۔ زہر دور کر دینا ۔ کاٹنے کے قابل نہ رکھنا ۔ جواب نہ آنے دینا ۔مُنّہ مانگا
صِفت
حسبِ طلب ۔ حسبِ مراد ۔ حسب مرضی ۔مُنّہ مانگا برپایا 
محاورہ
دل کے موافق خاوند ملا ۔ خاطر خواہ کام ہوا ۔مُنّہ مانگی مراد
اِسمِ مؤنّث
من کی چاہنا ۔ دل مراد ۔ دلی خواہش ۔مُنّہ مانگی موت
اِسمِ مؤنّث
مُنّہ کی مانگی ہوئی موت ۔مُنّہ مانگی موت نہیں ملتی 
کہاوت
جو آدمی چاہتا ہے وہ نہیں ہوتامُنّہ مانگے دام
اسمِ مُذکّرُ
حسبِ طلب قیمت ۔ مُنّہ کا مانگا ہوا مولمُنّہ مسل ڈالنا
فعل متعدّی
دانت جھاڑ دینا ۔ دنداں شکن جواب دینا ۔مُنّہ مسکوڑنا
فِعل لازِم
دیکھو(مُنّہ سکوڑنا)مُنّہ موڑنا
فِعل لازِم
روگرداں ہونا ۔ اعراض ہونا ۔ مُنّہ ہٹانا ۔ کنارہ کشی کرنا ۔ رُخ نہ دینا ۔ بغاوت کرنا ۔ انحراف کرنا ۔ پرہیز کرنا ۔ سمت بدلنا ۔ انکار کرنا ۔ دھار کا خم کھانا ۔ دغا دینا ۔ باز رہنا ۔مُنّہ میٹھا کرنا 
فعل متعدّی
شیرینی کھلانا  ۔ کچھ دینا ۔ عنایت کرنا ۔ منگنی کرنا ۔ نسبت کرنا ۔ گھوس دینا ۔مُنّہ میٹھا ہونا 
فِعل لازِم
شیرینی یا مٹھائی کھانا ۔ نسبت ہونا ۔ منگنی ہونا ۔ شُکرانہ ملنا ۔ رشوت ملنا ۔مُنّہ میں آب آجانا 
فِعل لازِم
مُنّہ میں پانی بھر آنا ۔ جی للچا جانا ۔مُنّہ میں آنا 
فِعل لازِم
زبان پر آنا ۔ مُنّہ سے نکلنا ۔مُنّہ میں بولنا 
فعل متعدّی
اس طرح بولنا کے دوسرے کی سمجھ میں نہ آئے ۔مُنّہ میں تنکا لینا 
فِعل لازِم
دانتوں میں تنکا لینا ۔ عاجزی کرنا ۔ خاک چاٹنا ۔ ہاتھ جوڑنا ۔مُنّہ میں تھوک بلونا 
فعل متعدّی
بےہودہ سرائی کرنا ۔ بے موقع اور بے معنی باتیں کرنامُنّہ میں تھوک لپٹے جانا 
فِعل لازِم
مُنّہ خُشک ہوئے جانا  ۔ مُنّہ سے بات نہ نکلنا ۔مُنّہ میں خاک 

بدفال یا بد شگون آدمی کے بارے میں بولتے ہیںمُنّہ میں دانت  نہ پیٹ میں آنت
کہاوت
نہایت بوڑھے پھونس کے حق میں بولتے ہیں ۔مُنّہ میں زبان حلال ہے 
محاورہ
مُنّہ میں زبان سچ اور حق بات کے واسطے ہے زبان بر حق ۔مُنّہ میں زبان نہیں
محاورہ
نہایت غریب اور بے زبان آدمی ۔مُنّہ میں زبان ہونا 
فِعل لازِم
قابلِ نوطق ہونا ۔ کہنے اور بولنے کی طاقت رکھنا ۔ جواب دینے کے قابل ہونا ۔مُنّہ میں مارنا
فعل متعدّی
تھپڑ لگانا ۔ طمانچہ لگانا ۔مُنّہ میں پان پھیکا ہونا 
فِعل لازِم
پان کا ذائقہ جاتا رہنا ۔مُنّہ میں پانی بھر آنا 
فِعل لازِم
مُنّہ میں رطوبت پیدا ہوجانا ۔ للچا جانا ۔ جی للچانا ۔ زبان پر کسی چیز کا مزہ آجانے سے اُس کی رغبت ہوجانا ۔ شوق پیدا ہونا ۔مُنّہ میں پانی چُو آنا 
فِعل لازِم
مرتے وقت مُنّہ میں پانی ٹپکانا  ۔ کسی سخت مریض کے مُنّہ میں بوندھ بوندھ پانی ڈالنا  ۔ مرتے وقت کام آنا ۔مُنّہ میں پڑنا 
فِعل لازِم
مُنّہ میں جانا ۔ کھانے میں آنا ۔ زباں زد ہونا ۔ زباں آشنا ہونا ۔مُنّہ میں پڑھنا 
فعل متعدّی
اس طرح سمجھنا کے دوسرے کو سمجھ نہ آئے ۔ ہونٹوں میں پڑھنا ۔مُنّہ میں پھیپڑیاں بندھ جانا 
فِعل لازِم
لب خُشک ہوجانا ۔مُنّہ میں کالک لگ جانا 
فِعل لازِم
رسوائی ہونا ۔ بدنامی ہونا ۔مُنّہ میں گُھنگنیاں بھر کر بیٹھنا 
فِعل لازِم
چُپ ناندھ کر بیٹھنا ۔ خاموش ہوکر بیٹھنا ۔مُنّہ میں گھنگنیاں بھرنا
فعل متعدّی
چُپ اختیار کرنا ۔ خاموشی اختیار کرنا ۔ گونگا بن جانا ۔مُنّہ نوح لینا 
فِعل لازِم
چہرے کو ناخنوں سے کُھرچ ڈالنا ۔مُنّہ نپوڑنا
فِعل لازِم
دانت نکوسنا ۔ دانت نکالنا ۔ بے وقوفوں کی طرح ہنسنا ۔ جواب نہ بن پڑنا ۔مُنّہ نکل آنا 
فِعل لازِم
چہرہ اُتر جانا ۔ گال پچک  جانا ۔ گال پٹخ جانا ۔ دُبلا ہوجانا ۔ علامتِ حمل کا ظاہر ہونا ۔مُنّہ نہ دکھا یا نہ دکھلا 

دور ہو ۔ صُورت نہ دکھا ۔ سامنے نہ آ۔ پرے ہٹ ۔مُنّہ نہ دکھانا 
فِعل لازِم
صورت نہ دکھانا ۔ سامنے نہ آنا ۔ پیش نہ کرنا ۔مُنّہ نہ دیکھنا
فِعل لازِم
صورت سے بیزار ہونا  ۔ ازحد بیزار ہونا ۔مُنّہ نہ لگانا 
فعل متعدّی
مُنّہ سے نہ چھونا ۔ مُنّہ کے پاس نہ لانا ۔مُنّہ نہ موڑنا 
فعل متعدّی
مُنّہ نہ پھیرنا ۔ رُخ نہ بدلنا ۔مُنّہ نہ پڑنا 
فِعل لازِم
حوصلہ نہ پڑنا ۔ جرأت نہ ہونا ۔مُنّہ نہ پھیرنا
فِعل لازِم
مُنّہ نہ موڑنا ۔ مستقل ہونا ۔ ارادہ پر قائم رہنا ۔مُنّہ نہ چڑھانا
فعل متعدّی
تیوری پر بَل ن ڈالنا ۔ خفا  نہ ہونا ۔ تُرش رو نہ ہونا ۔مُنّہ نہ چڑھنا
فِعل لازِم
چیں بہ چیں نہ ہونا ۔ خفا نہ ہونا ۔ مقابل نہ ہونا ۔ مقابلہ نہ کرنا ۔ گستاخ ہونا ۔ بے ادب ہونا ۔مُنّہ نہ کرنا 
فعل متعدّی
رُخ نہ کرنا ۔ کسی جانب جانے کا نام نہ لینا ۔مُنّہ نہ کُھلواؤ
محاورہ
زبان نہ کُھلواؤ ۔ عیب پوشیدہ  کو ظاہر نہ کراؤمُنّہ نہ ہونا 
فِعل لازِم
مجال نہ ہونا ۔ تاب نہ ہونا ۔مُنّہ ٹیڑھا کرنا 
فعل متعدّی
مُنّہ بنانا ۔ مُنّہ بگاڑنا ۔ خفگی کی صورت بنانا ۔مُنّہ پانا
فِعل لازِم
رُخ پانا ۔ توجہ پانا ۔ خوش پانا ۔مُنّہ پر
تابع فعل
سامنے ۔ روبرو ۔ بالمقابل ۔مُنّہ پر آنا 
فِعل لازِم
زبان پر آنا ۔ نمودار ہونا ۔ پیش آنا ۔مُنّہ پر بات لانا 
فعل متعدّی
کسی بات کا ظاہر  کرنا ۔ بھید کھولنا ۔مُنّہ پر برسنا 
فِعل لازِم
چہرے سے عیاں ہونا ۔ صُورت سے پایا جانامُنّہ پر بسنت پُھولنا
فِعل لازِم
مُنّہ پر زردی چھانا ۔ چہرہ زرد پڑ  جانا ۔ زرد روئی ہوجانا ۔مُنّہ پر تھوک دینا
فعل متعدّی
چہرے پر تھوک مارنا ۔ نہایت ذلیل و شرمندہ کرنا ۔ کسی کا خیال نہ کرنا ۔مُنّہ پر جانا 
فِعل لازِم
کسی کا خیال کرنا ۔ کسی کا لحاظ کرنا ۔مُنّہ پر جوتی سی لگنا 
فِعل لازِم
نہایت شرمندگی اور خفت حاصل ہونا ۔مُنّہ پر خاک اُڑنا 
فِعل لازِم
چہرے کا پریشان اور بے رونق ہونا ۔مُنّہ پر خاک ملی  ہے
محاورہ
یعنی مفلسی کو ظاہر کیا ہے اور دولت کو چھپایا ہے ،مُنّہ پر خوشامد  نہ کرنا 
فعل متعدّی
راست باز اور صاف گو ہونا ۔ پاسداری نہ کرنامُنّہ پر دانہ نہ رکھنا 
فِعل لازِم
بالکل نہ کھانا ۔ ایک دانہ تک نہ کھانامُنّہ پر رکھ دینا 
فعل متعدّی
سامنے کہدینا ۔ ظاہر کر دینا ۔مُنّہ پر رکھنا 
فعل متعدّی
سامنے کہنا ۔ روبرو کہنا ۔ ذکر کرنامُنّہ پر زردی پھر جانا 
فِعل لازِم
زردی چھا جانا ۔ مُنّہ زرد  ہو جانا ۔مُنّہ پر زردی کِھنڈ جانا 
فِعل لازِم
چہرہ زرد ہوجانا ۔ خون کا دوران بند ہو کر  مُنّہ کا سفید ہوجانا ۔مُنّہ پر شفق پھولنا
فِعل لازِم
خوشی سے مُنّہ  پر سُرخی آنا ۔مُنّہ پر فاختہ اُڑ جانا 
فِعل لازِم
چہرے کا رنگ بدل جانا ۔ مُنّہ فق ہوجانا ۔مُنّہ پر قُفل لگ جانا 
فِعل لازِم
مُنّہ بند ہوجانا ۔ سکُوت ہوجانا ۔مُنّہ پر مارنا 
فعل متعدّی
کسی بُری چیز کو واپس کرنا ۔مُنّہ پر مُردنی  پھرجانا 
فِعل لازِم
چہرے پر آثارِ مرگ کا نمایاں ہونا ۔ چہرے پر زردی چھا جانا ۔مُنّہ پر مُردنی چھانا 
فعل متعدّی
دیکھو(مُنّہ پر مُردنی  پھر جانا )مُنّہ پر مُنّہ رکھنا 
فعل متعدّی
رخسار پر رخسار رکھنا ۔ گال پر گال رکھنامُنّہ پر مُہتاب  چُھٹنا
فِعل لازِم
مُنّہ پر فق ہونا ۔ مُنّہ سفید یا زرد پڑنا ۔مُنّہ پر مہر لگا دینا
فعل متعدّی
مُنّہ پر قفل لگا دینا ۔ بات کرنے نہ دینا ۔ بولنے کا حکم نہ دینا ۔مُنّہ پر مہر لگنا 
فِعل لازِم
مُنّہ پر قفل لگنا ۔ سکوت ہونا ۔ خاموش ہونا ۔مُنّہ پر ناک نہ ہونا 
فِعل لازِم
لاج نہ ہونا ۔ شرم نہ ہونا ۔ حیا نہ ہونا ۔ بے غیرت ہونا ۔ بے حیثیت ہونا ۔مُنّہ پر نور نہ ہونا 
فِعل لازِم
چہرے پر رونق نہ ہونا ۔ چہرے کی شادابی اور رونق کا جاتا رہنامُنّہ پر نہ رکھنا 
فعل متعدّی
زبان پر نہ رکھنا ۔ ذائقہ معلوم نہ کرنا ۔ سامنے نہ کہنا ۔مُنّہ پر نہ کہنا
فِعل لازِم
روبرو نہ کہنا ۔ سامنے بیان نہ کرنا ،۔مُنّہ پر پانی پھر جانا 
فِعل لازِم
مُنّہ پر رونق آجانا ۔ مُنّہ پر تازگی آجانا ۔مُنّہ پر پھینک دینا 
فعل متعدّی
دیکھو(مُنّہ پر مارنا)مُنّہ پر پھینک مارنا
فعل متعدّی
خفگی سے کسی چیز کو واپس کر دینا ۔ واپس کر دینا ۔مُنّہ پر چڑھنا
فِعل لازِم
مُقابل ہونا ۔ مُقابل آنا ۔ سامنے آنا ۔مُنّہ پر کچھ نہ رکھنا 
فعل متعدّی
کچھ نہ کھانا ۔ زبان پر نہ لانا ۔مُنّہ پر کُچھ پیٹھ پیچھے کچھ 
محاورہ
ظاہر میں کچھ باطن میں کچھمُنّہ پر کہ بیٹھنا 
فعل متعدّی
سامنے کہدینا ۔ ظاہر کر دینا ۔مُنّہ پر کہ دینا 
فعل متعدّی
روبرو کہدینا ۔ صاف کہدینا ۔مُنّہ پر کہنا 
فعل متعدّی
روبرو کہدینا ۔ صاف کہدینا ۔ سامنے بیان کرنا ۔مُنّہ پر کہنا خوشامد ہے 
کہاوت
آپ کا ظاہر اور باطن ہمہ صفت موصوف ہے بیان کی حاجت نہیں ۔مُنّہ پر کی ساری باتیں ہیں 
محاورہ
روبرو مہر و محبت ہے اور پیٹھ پیچھے عداوت و نفرت ہے ۔مُنّہ پر گرم ہونا 
فِعل لازِم
شوخ چشمی سے مقابلہ کرنا ۔ بڑے کے مقابل ہوجانا ۔مُنّہ پر ہاتھ رکھنا 
فعل متعدّی
بولنے سے روکنا ۔ بات نہ کرنے دینا ۔ مُنّہ بند کرنا ۔مُنّہ پر ہاتھ پھروانا
فعل متعدّی
گالوں یا رخساروں کا مساس کرانا ۔ چوما چاٹی کرانا ۔مُنّہ پر ہاتھ پھیرنا
