قُوّت
اِسمِ مُذکّر
اہل۔ طاقت۔ زور۔ شکتی۔ توانائی۔ قدرت۔ مجال۔ تاب۔ سہارا۔ مدد۔ اعانت۔ تقویت۔ سلطنت۔ ریاست۔قُوتِ الایَمُوت
اِسم مُؤنّث
اس قدر خوراک کہ جس سے جسم خاکی کا قیام رہے۔  زندگی قائم رہنے کے قابل خورش۔قُوّتِ باصرہ
اِسم مُؤنّث
وہ قوت جس سے رنگون اور صورتوں کی تمیز کی جاتی ہے۔ بینائی، بصارت۔ آنکھ کی روشنی۔قُوت باہ
اِسم مُؤنّث
شہوت۔ قوتِ جماع۔ زورِ مجامعت۔قُوت بَسری کرنا
فعل مُتعدّی
اوقات بسری کرنا۔ زندگی بسر کرنا۔ بُرا بھلا کھا کر زندگی کاٹنا۔ مُصیبت کا زمانہ روکھی سوکھی کھا کر بسر کرنا۔ گزارا کرنا۔قُوت بسری ہونا
فِعل لازِم
گُزارا ہونا۔ کھاتا پیتا چلنا۔ جوں تون کر کے زندگی کے دن کاٹنا۔ گزر اوقات ہونا۔قُوت جاذبہ
اِسم مُؤنّث
جذب کرنے اور سوکھ لینے والی قُوت۔ چوس لینے والی قوت۔ غذا کھینچ لینے والی قوت۔قُوّتِ جسمانی
اِسم مُؤنّث
جسمی طاقت۔ دیہی بَل۔ طاقت جسمانی۔ بدنی طاقت۔قُوّتِ حافظہ
اِسم مُؤنّث
قہ قوت جو حواس طاہر و باطنہ سے حاصل شدہ بات کو دماغ میں محفوظ اور موجود رکھتی ہے۔ یاداشت کی قوت۔قُوّتِ دافِعہ
اِسم مُؤنّث
ہتانے اور دفع کرنے کی قوت۔ باہر نکالنے والی قوت۔ خارج کرنے والی قوت۔قُوّت دینا
فعل مُتعدّی
طاقت بخشنا۔ زور دینا۔ مضبوط کرنا۔قُوتِ ذائقہ
اِسم مُؤنّث
چیزوں کا مزہ بتانے والی قوت۔ لذت بتانے والی قوت۔قُوّتِ سامعہ
اِسم مُؤنّث
وہ قوت جس سے آوازوں کی تمیز کی جاتی ہے۔ یہ قوت کانوں سے متعلق ہے۔ سُنائی دینے کی قوت۔قُوتِ شامہ
اِسم مُؤنّث
وہ قوت جس سے بُری بھلی بُو کی تمیز کی جاتی ہے۔ بُو پہچاننے والی قوت۔ یہ قوت ناک سے متعلق ہے۔قُوتِ لامِسہ
اِسم مُؤنّث
چھونے اور مس کرنے کی قوت۔قُوّتِ ماسکہ
اِسم مُؤنّث
وہ قوت جو غذا کو معدے میں محفوظ رکھتی ہے۔ غذا کو روکے رکھنے والی قُوت۔قُوّتِ مُتَصَرفہ
اِسم مُؤنّث
بعض صور کو بعض معانی کے ساتھ نسبت دینے والی قُوت۔قُوّتِ مُدرکہ
اِسم مُؤنّث
دریافت اور معلوم کرنے کی قُوت۔ جسے سمجھ ، فہم، بُدھ، گیان وغیرہ کہتے ہیں۔قُوّتِ ہاضِمہ
اِسم مُؤنّث
کھانا پچانے کی قُوت۔قورمہ
اِسمِ مُذکّر
بریاں۔ گھی میں بھنا ہؤا گوشت۔ بُھنا ہؤا گوشت جس مین ہلدی اور شوربہ نہیں ڈالتے۔قوس
اِسم مُؤنّث
کمان۔ دھنک۔ دھنش۔ دائرہ کا وہ حصہ جو وتر اور محیط کے کسی حصہ سے گھرا ہؤا ہو۔ آسمان کے نویں برج کا نام جو بشکل کمان مانا گیا ہے۔قَوس قُزح
اِسم مُؤنّث
وہ کامن جو ابر میں رنگ برنگ کے رنگوں سے بنی ہوئی دکھائی دیتی ہے۔ آفتاب کے رنگ برنگ کی شعاعوں کے بخارات آبی میں رکنے سے جو قوسی صورت پیدا ہوتی ہے اُسے قوس قزح کہتے ہیں۔ کمانِ شیطان۔ کمانِ رستم۔قوس نما
صِفت
محرابدار۔ کمان کی وضع کا۔ قوسی۔قَوسی
صِفت
دیکھو ( قوس نما)قَول
اِسم،
بات۔ بچن۔ سخن۔ کہن۔ کہنا۔ کہاوت۔ ملفوظ۔ عہد و قرار۔ قسم۔ سوگند۔قول توڑنا
فعل مُتعدّی
عہد توڑنا۔ وعدہ خلافی کرنا۔ دلیل توڑنا۔ بات رد کرنا۔قول دینا
فعل مُتعدّی
بچن ہارنا۔ ہاتھ پر ہاتھ مارنا۔ عہد و پیمان کرنا۔ عہد باندھنا۔ قسم کھانا۔ اقرار کرنا۔قول سے پھرنا
فعل مُتعدّی
بات سے پھرنا۔ وعدے سے انکار کرنا۔ عہد شکنی کرنا۔ خلاف ورزی کرنا۔ زبان سے پھرنا۔قول قرار
اِسمِ مُذکّر
اقرارو مدار۔ عہد و پیمان۔قول قرار کرنا
فعل مُتعدّی
اقرار مدار کرنا۔ زبان دینا۔ بچن دینا۔قول لینا
فعل مُتعدّی
عہد لینا۔ بچن لینا۔ اقرار لینا۔ سوگند کھانا۔ حلف اُٹھوانا۔قول مرداں جاں دارد
کہاوت
شریفوں کی بات پتھر کی لکیر ہوتی ہے۔ مردوں کی زبان پکی ہوتی ہے۔قول و جسم
اِسمِ مُذکّر
عہد و پیمان۔ قسماقسمی۔ اقرار و مدار۔قول و فعل
اِسمِ مُذکّر
گفتار و کردار۔ چال چلن۔ راہ و روش۔ طور طریق۔قول کا پُورا
صِفت
بات کا پکّا۔ راسخ الکلام۔ سچا۔قول کا چھلّا
اِسمِ مُذکّر
وہ چھلا جو بطور عہد  یاد داشت کے واسطے عاشق و معشوق ایک دوسرے کو دیتے ہیں۔ ایک قسم کا چھلا جس کی ساخت اس طرز پر ہوتی ہے کہ اخیر پر پنجے سے پنجہ اس طرح ملا ہؤا ہوتا ہے کہ گویا کوئی ہاتھ میں ہاتھ دے کر قول کر رہا ہے۔قول ہارنا
فعل مُتعدّی
بچن ہارنا۔ زبان دینا۔ عہد کرنا۔ ہاتھ پر ہاتھ مارنا۔قُولَنج

وہ درد جو قولون انتٹری میں پیدا ہوتا ہے۔ ایک قسم کا درد شکم۔ پسلی کے نیچے کا درد۔قَوم
اِسم مُؤنّث
آدمیوں کا گروہ۔ گروہ مردان۔ فرقہ۔ خاندان۔ کُل۔ کانوادہ۔ جات۔ نسل۔ ذات۔ گوت۔قوم دار
صِفت
اچھی نسل کا،۔ اچھے کھیت کا۔ خاندانی۔قومہ
اِسمِ مُذکّر
نماز میں رکوع کے بعد کھڑا ہونا۔قومی
صِفت
جاتی۔ ایک مذہب یا ملت یا ملک یا سلطنت کے لوگ۔ وطنی۔ دیسی۔قومی مجلس
اِسم مُؤنّث
ہم قوم لوگوں کی انجمن۔ ہموطنوں کی سوسائٹی۔قَومیّت
اِسم مُؤنّث
ایک جاتی۔ نسل۔ اصل۔ تعلق مذہبی۔قَوی
صِفت
توانا۔ زور آور۔ زبردست۔ طاقت ور۔ شکتی مان۔ ٹھاڑا۔ بلونت۔ قوت والا۔ مضبوط۔ مستحکم۔ استوار۔ کڑا۔ کٹھن۔ موٹا تازہ۔ تنومند۔قَوی حُبثہ
صِفت
موٹا تازہ۔ فربہ اندام۔ بھاری جسم کا۔ تن و توش کا۔ مضبوط جسم کا۔قَوی ہیکل
صِفت
زور آور۔ شہ زور۔ بلونت۔ قدآور۔قَہار
صِفت
بہت قہر کرنے والا۔ غضبی۔ بہت غالب۔ جبار۔ یہ لفظ خدا تعالیٰ کے اسماے صفات میں سے ہے۔ بڑے دریا کی صفت میں بھی آتا ہے۔قَہاقا
اِسمِ مُذکّر
قہقہہ۔ ٹھٹا۔ کھل کھلا کر ہنسنا۔قَہر
اِسمِ مُذکّر
غلبہ۔ زبردستی۔ زور آوری۔ طیش۔ غضب ۔ غُصہ۔ خشم۔ خفگی۔ کوپ۔ چھو۔ جوش۔ جذبہ۔ تیزی۔ غضبناکی۔ دشوار کام۔ کٹھن بات۔ نہایت مشکل امر۔ بلا۔ آفت۔ شامت۔قہر الٰہی
اِسمِ مُذکّر
غضب خدا۔ بلاے آسمانی۔قہر توڑنا
فعل مُتعدّی
غضب ڈھانا۔ آفت برپا کرنا۔ نہایت غصے ہونا۔ ازحد غصہ کرنا۔قہر قیامت
صِفت
خوبصورتی یا شوخی میں کوٹ کوٹ کر بھرا ہؤا۔ نہایت خوبصورت و حسین۔ فتنہ پرداز۔ فتنہ زاقہر ٹوٹنا
فِعل لازِم
غضب الٰہی نازل ہونا۔ آفت آنا۔ خادا کی طرف سے بدی کا بدلہ ملنا۔ خفگی ہونا۔ ناراضگی ہونا۔قہر کا
صِفت
آفت کا۔ بلا کا۔ غضب کا۔ قایامت کا۔ نہایت۔ ازحد۔ بے شمار۔ ہولناک۔ خوفناک۔ آفت کا پرکالا۔ نہایت چالاک۔ شوخ۔ عیّار۔قہر کا سامنا
اِسمِ مُذکّر
غضب کا سامنا۔ آفت کا مقابلہ۔قہر کرنا
فعل مُتعدّی
غضب کرنا۔ بُرا کرنا۔ بے جا کرنا۔ ظلم کرنا۔ ستم کرنا۔ قابل حیرت کام کرنا۔ انوکھا کام کرنا۔قہر کی آنکھ سے دیکھنا
فعل مُتعدّی
غضب آلود یا نگاہ خشم آگین سے دیکھنا۔ نیلی پیلی آنکھیں کرنا۔قہر ہوتا ہے
فعل مُتعدّی
بُرا ہوتا ہے۔ غضب ہوتا ہے۔ آفت ہوتا ہے۔قہر ہے
مُحاورہ
آفت ہے۔ بلا ہے۔ مصیبت ہے۔ نہایت شوخ۔ عیار اور چالاک۔قہراً
تا
جبراً۔ زبردستی سے۔ زور و ظلم سے۔ مجبوراً۔قَہقہہ
اِسمِ مُذکّر
ٹھٹا۔ خندۂ بآواز۔ پُکار کر ہنسنا۔ کھل کھلا کر ہنسنا۔ ۔ ایک قلعہ کا نام جسے کہہ کہہ بادشاہ نے بنایا تھا۔ اور وہ اب تک ٹوٹا پھوٹا علاقہ طوس میں واقع ہے۔قَہقَہہ اُڑانا
فعل مُتعدّی
ٹھٹا مارنا۔ ہنسی اُڑانا۔ مضحکہ کرنا۔ احمق بنانا۔قَہقَہہ لگانا
فعل مُتعدّی
ٹھٹا مارنا۔ کھل کھلا کر ہنسنا۔ آوازہ لگانا۔ مضحکہ اُڑانا۔ تمسخر کرنا۔ احمق بنانا۔قہوہ
اِسمِ مُذکّر
کافی۔ ایک قسم کے تخم کا نام ہے۔ اسے بھون کے پیستے اور پھر پانی میں چاہ کی طرح جوش دے کر پیتے ہیں۔قہوہ خانہ
اِسمِ مُذکّر
وہ مکان جہاں تمام قہوہ باز جمع ہو کر قہوہ پیتے اور گپ شب اُڑاتے ہیں۔ اس کا دستور عرب ، بمبئی اور کلکتہ میں ہے۔قَیاس
اِسمِ مُذکّر
دو چیزوں کا فکر میں اندازہ کرنا۔ جانچ۔ اندازہ۔ تخمیہ۔ انومان۔ ذہم۔ فہم۔ عق؛۔ سمجھ۔ دانست۔ گمان۔ خیال۔ تصور۔ سوچ۔ قیافہ۔قیاس سے باہر
تابع فِعل
بے اندازہ۔ بیشمار۔ خارج از حساب۔ بے حساب۔ ان گنت۔ تصور یا خیال کی حد سے گزرا ہؤا۔ سمجھ سے باہر۔قیاس لگانا
فعل مُتعدّی
راے لگانا۔ سوچنا۔ بچار کرنا۔ عقل لڑانا۔ ھساب لگانا۔قیاس میں آنا
فِعل لازِم
سمجھ میں آنا۔ قرین عقل ہونا۔ خیال میں آنا۔قیاس کرنا
فعل مُتعدّی
اندازہ کرنا۔ جانچنا۔ انومان کرنا۔ اٹکلنا۔ گمان کرنا۔ خیال کرنا۔ ماننا۔ تسلیم کرنا۔قیاساً
تابع فِعل
ازروے قیاس۔ اٹکل سے۔ اٹکل پچو۔ اندازاً۔ تخمیناً۔قیاسی
صِفت
قاعدہ کے موافق۔ منسوب بہ قیاس۔ خیالی۔ وہمی۔ ذہنی۔ تصوری۔قیافہ
اِسمِ مُذکّر
شگون۔ فال۔ ایک علم کا نام جس می ہاتھ پیر اور چہرے وغیرہ کے خط و خال و علامات سے بُرا بھلا شگون لیتے ہیں۔ قیاس۔ اندازہ۔ عقل۔ سمجھ۔ پہچان۔قیافہ شناس
اِسمِ مُذکّر
علم قیافہ سے واقف۔ قیافہ دان۔ شگونیا۔ فالیا۔قیافہ شناسی
اِسم مُؤنّث
علم قیافہ سے واقفیت۔ قیافہ دانی۔قِیام
اِسمِ مُذکّر
ٹھیراؤ۔ کھڑا ہونا۔ اُٹھنا۔ سکونت۔ بسیرا۔ بسرام۔ پائداری۔ استحکام۔ بقا۔ وثوق۔ اعتماد۔ موجودگی۔ نماز مین کھرا ہونا۔قیام پزیر
صِفت
ٹھیراؤ۔ دیر پا۔ دیر تک رہنے والا۔ ٹکاؤ۔ مقیم۔ فروکش۔قِیام کرنا
فعل مُتعدّی
مقام کرنا۔ ٹھیرنا۔ فروکش ہونا۔قِیامت
اِسم مُؤنّث
قائم ہونا۔ کھڑا ہونا۔ اِستادہ ہونا،۔ وہ وقت جب مُردے زندہ ہو کر کھڑے ہوں گے۔ روز حشر۔ یوم الحساب۔ مر کر اُٹھنے یا دوبارہ زندہ ہونے کا دن۔ روز باز پرس۔ روز شمار۔ سب کے مرنے اور فنا ہونے کا دن۔ انوکھی بات۔ کار عجیب۔ تعجب انگیز بات۔ بلا۔ آفت۔ قہر۔ ستم۔ بلاے جان۔قیامت آنا
فِعل لازِم
حشر برپا ہونا۔ آفت آنا۔ فتنہ برپا ہونا۔ بلا نازل ہونا۔ مصیبت پڑنا۔قیامت اُٹھانا
فعل مُتعدّی
آفت برپا کرنا۔ فساد مچانا۔ فتنہ برپا کرنا۔ شور مچانا۔قیامت اُٹھنا
فِعل لازِم
آفت برپا ہونا۔ فساد مچنا۔ شور و شر ہونا۔قیامت برپا کرنا
فِعل لازِم
فتنہ اُٹھانا۔ فساد مچانا۔ دھوم ڈالنا۔ مصیبت ڈالنا۔ آفت لانا۔قیامت توڑنا
فعل مُتعدّی
نہایت خفا ہونا۔ آفت برپا کرنا۔ حشر توڑنا۔ شور کرنا۔ ظلم کرنا۔ نہایت ستانا۔ جوروجفا سے پیش آنا۔قیامت لانا
فعل مُتعدّی
آفت برپا کرنا۔ مُصیبت لانا۔ بلا میں پھنسانا۔ ظلم ڈھانا۔ غضب میں مُبتلا کرنا۔ فساد مچانا۔قیامت مچانا
فعل مُتعدّی
ظلم توڑنا۔ دھوم ڈالنا۔ خفا ہونا۔ شور کرنا۔ آفت برپا کرنا۔ واویلا کرنا۔ کہرام مچانا۔ اودھم مچانا۔قیامت مچنا
فِعل لازِم
کہرام ہونا۔ ماتم پڑنا۔ واویلا مچنا۔ خفگی ہونا۔ آفت ٹوٹنا۔ سر ہونا۔قیامت ٹوٹنا
فِعل لازِم
حشر برپا ہونا۔ آفت ٹوٹنا۔ قہر ٹوٹنا۔ شامت آنا۔ ازحد خفگی ہونا۔قیامت ڈھانا
فعل مُتعدّی
فتنہ اُٹھانا۔ ستم کرنا۔ ظلم کرنا۔ غضب کرنا۔ واویلا مچوانا۔  آفت توڑنا۔ اُودھم مچانا۔ نہایت خفا ہونا۔ آگ بگولا ہونا۔قیامت کا
صِفت
آفت ڈھانے والا۔ غضب کا بنا ہؤا۔ قہر کا۔ فتنہ انگیز۔ ازحڈ خوبصورت۔ بیڈھب۔قیامت کرنا
فعل مُتعدّی
غضبب کرنا۔ بُرا کرنا۔ آفت لانا۔ مُصیبت لانا۔ ظلم ڈھانا۔ ستم کرنا۔ قہر توڑنا۔ خفا ہونا۔ شور مچانا۔قیامت گزرنا
فِعل لازِم
آفت گزرنا۔ مُصیبت کا سامنا ہونا۔ غضب میں پھنسنا۔ قہر نازل ہونا۔ حشر توٹنا۔قیامت ہو جانا
فِعل لازِم
غضب ہو جانا۔ آفت ہو جانا۔ زہر ہو جانا۔ بُرا ہو جانا۔قیامت ہونا
فِعل لازِم
حشر کے دن کا ہونا۔ عالم فنا ہونے کا وقت آنا۔ مُصیبت ہونا۔ آفت ہونا۔ مُشکل ہونا۔ حد بُرا ہونا۔قیامت ہے
مُحاورہ
آفت ہے۔ بلا ہے۔ مصیبت ہے۔ نہایت شوخ۔ عیار اور چالاک۔قَید
اِسم مُؤنّث
بند۔ حبس۔ اسیری۔ بندی۔ ممانعت۔ روک۔ شرط۔ پابندی۔ مقدار۔ اندازہ۔قید بلا مشقت
اِسم مُؤنّث
وہ قید جس میں قیدی سے محنت نہ لی جائے اور خوراک معمول سے کم۔ قید محض۔قید بھرنا
فِعل لازِم
قید خانہ میں بسر کرنا۔ محبوس رہنا۔قید تنہائی

اکیلی قید۔ تنہا رہنے کی قید۔قَید خانہ
اِسمِ مُذکّر
جیل خانہ۔ زنداں۔ بندی خانہ۔ قیدیوں کے رہنے کا مکان۔قَیدِ فرنگ
اِسم مُؤنّث
اہل فرنگ کی ایک قسم کی قید تھی جس میں چھٹکارا مشکل سے ہؤا کرتا تھا۔قید قفس
اِسم مُؤنّث
پنجرے کی قید۔ نہایت سخت قید جس میں آدمی کو پنجرے سے باہر نکلنا دشوار ہے۔قید لگانا
فعل مُتعدّی
حد لگانا۔ محدود کرنا۔ شرط باندھنا۔ مشروط کرنا۔ لازم گرداننا۔ پابند کرنا۔قید محض
اِسم مُؤنّث
قید بلا مشقت۔قید کرنا
فعل مُتعدّی
بند کرنا۔ انداں میں بھیجنا۔ اسیر کرنا۔ روکنا۔ ضبط کرنا۔ پابند۔ گرفتار کرنا۔ ؎قید ہونا
فِعل لازِم
جیلخانہ جانا۔ پکڑا جانا۔ پابند ہونا۔ محدود ہونا۔قیدی
اِسمِ مُذکّر
اسیر۔ بندھا۔ گرفتار۔ پکڑا ہؤا۔ مُجرم۔ سزا یافتہ۔قیدی دان
اِسمِ مُذکّر
بندھوا۔ مُقید۔قَیس
اِسمِ مُذکّر
عرب کے ایک قبیلہ کا مورثِ اعلےٰ۔ ایک قبیلہ کا نام جو بنی مصر یعنی قیس غیلان کی اولاد سے ہے۔قیصر
اِسمِ مُذکّر
قیصر لاطینی ززبان میں اس بچہ کو کہتے ہیں کہ وہ ابھی اپنی ماں کے پیٹ میں ہی ہو اور اس کی ماں مر جائے۔ اور وہ امں کے پیٹ سے چیر کر نکالا جائے چونکہ روم کا اول بادشاہ اغسطوس اسی طرح پیدا ہؤا تھا اور بڑا زبردست اور صاحب اقبال تھا۔قیصر روم

سلطان روم۔ شہنشاہ روم ۔قَیطُون
اِسمِ مُذکّر
ایک قسم کی زری اور ریشم کی بٹی ہوئی ڈوری۔ ایک قسم کا باریک پیچک۔قِیف
اِسمِ مُذکّر
ایک ٹونٹی دار ظرف کا نام جس کا مُنہ اُوپر سے کُھلا ہؤا اور نیچے ایک نلی لگی ہوئی ہوتی ہے اس کے ذریعے سے رقیق چیز بوتل وغیرہ میں با آسانی بھری جاتی ہے۔قیل و قال
اِسم مُؤنّث
گفتگو۔ بات چیت۔ رد و کد۔ بحثا بحثی۔ تکرار و مباحثہ۔قیلولہ
اِسمِ مُذکّر
دوپہر کا سونا۔ خواب چاشت گاہ۔ کھانا کھا لینے کے بعد لیٹنا۔قیلولہ کرنا
فِعل لازِم
کھانا کھا کر لیٹنا۔ دوہر کو سونا۔قِیمت
اِسم مُؤنّث
زر۔ مول ۔ دام۔ بھاؤ۔ نرخ۔ قدر۔ مرتبہ۔ منزلت۔قیمت لگانا
فعل مُتعدّی
دام لگانا۔ مُول قرار دینا۔قیمت مقرر کرنا
فعل مُتعدّی
دام تجویز کرنا۔ مول ٹھیرانا۔ بھاؤ لگانا۔قیمت ٹھیرانا
فعل مُتعدّی
مول چُکانا۔ بھاؤ مقرر کرنا۔قیمت پانا
فعل مُتعدّی
دام وصول کرنا۔ مول بھر پانا۔قیمت چُکانا
فعل مُتعدّی
بھاؤ ٹھیرانا۔ مول مقرر کرنا۔قیمتی
صِفت
بیش بہا۔ گراں۔ زیادہ قیمت۔ عمدہ۔ نفیس۔ عزیز۔قیمہ
اِسمِ مُذکّر
کٹا ہؤا گوشت۔ ریزہ ریزہ کیا ہؤا گوشت۔قیمہ قیمہ کرنا
فعل مُتعدّی
ٹکڑے ٹکڑے کرنا۔ ریزہ ریزہ کرنا۔ باریک کاٹنا۔قیمہ کرنا
فعل مُتعدّی
کاٹ کر چھوٹے چھوٹے ٹکڑے کرنا۔ پُرزے اُڑانا۔ تلوار سے کچلا کرنا۔قیمہ ہونا
فِعل لازِم
ٹکڑے ہونا۔ ریزے ہونا۔قینشی کی طرح زبان چلنا
فعل مُتعدّی
