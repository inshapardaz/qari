وہ نگینہ جس میں پیڑ سے بنے ہوئے ہوں۔ سنگ شجر۔شجرہ
اِسمِ مُذکّر
درخت۔ پودا۔ نسب نامہ۔ کرسی نامہ۔ سلسلہ۔ وہ کاغذ جس  میں مورث اعلیٰ کی کُل اولاد ترتیب وار درج ہو۔ کھیت کا نقشہ۔شجرہ قُلّہ
اِسمِ مُذکّر
پیروں کا شجرہ اور ٹوپی جو تبرکاً مریدوں کو دی جاتی ہے۔ بدھنا بوریہ۔ استر بستر۔ اسباب و سامان۔ اٹالہ۔شجرہ قُلّہ اُٹھانا
فعل مُتعدّی
بدھنا بوریا سمبھالنا۔ استر بستر باندھ کر چلنے کی تیاری کرنا۔شجرہ و کلہ
اِسمِ مُذکّر
سلسلہ کے پیروں کا نام اور پیر کی ٹوپی جو تبرکاً کسی مرید خاص یا سجادہ نشین کو دی جاوے۔شَحم
اِسم مُؤنّث
چربی۔ مُٹاپا۔ فربی۔ گودا۔ مغز۔شِحنہ
اِسمِ مُذکّر
کوتوال۔ محافظ شہر۔ وہ شخص جسے بادشاہ انتطام شہر اور لوگوں کی دمکی کے واسطے مقرر کیا جائے۔شخص
اِسمِ مُذکّر
آدمی کا جسم ۔ وجود انسان۔ بدن۔ آدمی۔ بشر۔ طرفہ معجون۔ انوکھا آدمی۔شخص ثالث
اِسمِ مُذکّر
تیسرا آدمی جو دو میں فیصلہ کرائے۔ سرپنچ۔شخص غیر
اِسمِ مُذکّر
اجنبی آدمی۔شخص واحد
اِسمِ مُذکّر
اکیلا آدمی۔ ایک آدمی۔ تنہا آدمی۔ وہ شخص جس کا کوئی ساتھی یا مدد گار نہ ہو۔شخصی
صِفت
ایک آدمی سے متعلق۔ شخص واحد سے منسوب۔شخصی حکومت
اِسم مُؤنّث
وہ حکومت جس میں بادشاہ کو اختیار مطلق حاصل ہو۔شخصیت
اِسم مُؤنّث
انسانیت۔ آدمیت۔ بشریت۔ اشرافت۔ بھلامانسی۔ بھلائی۔ عزت۔ حرمت۔ شان۔ وقار۔شخصیت جتانا
فعل مُتعدّی
شیخی مارنا۔ ڈینگ کی لینا۔ اترانا۔شَدّ

سختی۔ مضبوطی۔ اُستواری۔ 
***
شُد
فِعل لازِم
رفت و گزشت۔ کسی کام کا آغاز یا ابتدا۔شُد آمد سے
تابع فِعل
قدامت سے۔ ابتدا سے۔ اوّل سے۔ پُرانی رسم یا رواج کے موافق۔شُد بُد
اِسم مُؤنّث
کسی کام کی تھوڑی سی واقفیت یا مہارت۔ تھوڑا سا درک۔ حرف شناسی۔ قدر قلیل واقفیت۔شَدّا
اِسمِ مُذکّر
عَلم ۔ وہ جھنڈا یا جھنڈی جو شہداے کربلا کی یاد میں محرم میں نکالا کرتے یا تعزیوں کے ساتھ رکھتے ہیں۔شُدبُد ہونا
فِعل لازِم
تھوڑا سا علم یا واقفیت ہونا۔ حرف شناسی ہونا۔ ذرا سی مداخلت ہونا۔شِدّت
اِسم مُؤنّث
سختی۔ تیزی۔ کشٹ۔ شُندی۔ خشونت۔ تکلیف۔ جوش و خروش۔ قوت۔ زیادتی۔ کثرت۔ ترقی۔ غلبہ۔ زبردستی۔ سینہ زوری۔شِدّت سے
تابع فِعل
زور سے۔ سختی سے۔ کثرت سے۔ افراط سے۔شِدّت کا
صِفت
زور کا۔ بہت سا۔ سخت۔شُدنی
اِسم مُؤنّث
ہونے والی بات۔ ہونی۔ بھادی۔ ہونہار۔ ممکن۔شَدّومد
اِسم مُؤنّث
دھوم دھام۔ تزک و احتشام۔ ٹھاٹ۔شُدّھ
صِفت
پاک ۔ صاف۔ پوتر۔ ستھرا۔ خالص۔ ٹھیک۔ درست۔ اُجلا۔ نرمل۔ سفید۔شُدھ شُدھ
تابع فِعل
رفتہ رفتہ۔ درجہ بدرجہ۔ ہوتے ہوتے۔  آہستہ آہستہ۔شَدّہ
اِسمِ مُذکّر
حملہ۔ دھاوا۔ چونکہ یورش کے وقت فوج کا جھنڈا آگے رہتا ہے۔ اس وجہ سے اس کے معنی جھنڈا، عَلم ، نشان وغیرہ ہو گئے۔ مگر ہندوستان میں شدہ اُس عَلم کو کہتے ہیں جو تعزیوں کے ساتھ رہتا ہے۔شَدید
صِفت
سخت۔ کٹھن۔ اُستوار۔ مشکل۔ دشوار۔ بہت زیادہ۔ بھاری۔شدیدُ العداوت
اِسمِ مُذکّر
دشمن سخت۔ جانی دشمن۔شَر
اِسمِ مُذکّر
بدی۔ شرارت۔ بُرائی۔ خرابی۔ کھوٹ۔ بگاڑ۔ فتنہ و فساد۔ جھگڑا۔شر اُٹھانا
فعل مُتعدّی
جھگڑا اُٹھانا۔ فتنہ برپا کرنا۔ فساد کرنا۔شِر کت
اِسم مُؤنّث
شمول۔ شمولیت۔ اشتراک۔ ساتھ۔ ہمراہی۔ ساجھا۔شِرا
اِسمِ مُذکّر
خرید و فروخت۔ بیع کا نقیض۔ خرید۔شَرائط
اِسم مُؤنّث
شرط کی جمع۔ شرطیں۔شَرائین
اِسم مُؤنّث
تمام جسم میں خون پہنچانے والی رگیں ۔شَراب
اِسم مُؤنّث
عرق۔ پینے کی شے ا میں شربت ہو یا پانی۔ نشہ کرنے والا عرق۔ مَے۔ صہبا۔ بادہ۔ 
***
شراب
اِسمِ مُذکّر
خوردنی۔ نوش۔شراب خانہ
اِسمِ مُذکّر
میخانہ۔ مے کدہ۔ خرابات۔ پاسی خانہ۔ شاراب بکنے کی جگہ۔شراب خواری
اِسم مُؤنّث
بادہ کشی۔ مے نوشی۔شراب خور
اِسمِ مُذکّر
شرابی۔ بادہ نوش،۔شراب طہور
اِسم مُؤنّث
وہ پاک صاف شراب جو بہشت میں جنتیوں کو ملے گی۔شراب پُرتگالی
اِسم مُؤنّث
ملک پُرتگال کی بنی ہوئی شراب ۔ عمدہ شراب۔شراب پینا
فعل مُتعدّی
مے نوشی کرنا۔ شراب کا عادی ہونا۔شرابور
صِفت
تر بتر۔ شور بور۔ ستھ پتھ۔ لتھڑ پتڑ۔شرابی
اِسم مُؤنّث
شراب کور۔ بادہ کش۔ قدح کش۔ (صفت) متوالا۔ مست۔ سرمست۔ مخمور۔شرادھ
اِسمِ مُذکّر
کریاکرم۔شرار
اِسمِ مُذکّر
آگ کا پتنگا۔ چنگاری۔ پارۂ آتش۔شرارت
اِسم مُؤنّث
بدی۔ برائی۔ ایذا رسانی۔ کھوٹ۔ کھٹائی،۔ بد ذاتی۔ نٹ کھٹی۔ شوخی۔ طراری۔ بے باکی۔ چالاکی۔ دلیری۔شَرارت کرنا
فعل مُتعدّی
بدی کرنا۔ بُرائی کرنا۔ شوخی کرنا۔ دنگا کرنا۔شَرارتاً
تابع فِعل
ازروے شرارت۔ شرارت سے۔ شیطنت سےشَرارہ
اِسمِ مُذکّر
آگ کا پتنگا۔ چنگاری۔ پارۂ آتش۔شِرازہ
اِسمِ مُذکّر
وہ بنا ہؤا رنگین خواہ سفید فیتہ جو کتابوں کی جزو بندی کے بعد پشتے کے دونوں طرف خوبصورتی اور سلائی کے جکڑا رہنے کے واسطے لگا دیتے ہیں۔ انتظام۔ سلسلہ۔ بندش۔ اجتماع۔شِرازہ بندی
اِسم مُؤنّث
جلد بندی۔ جز بندی۔ دوخت کتاب۔ کتاب کی سلائی۔شِرازہ کُھلنا
فعل مُتعدّی
ٹانکا ٹوٹنا۔ سلائی کُھل جانا۔ انتظام یا ترتیب کا قائم نہ رہنا۔شِرازی
صِفت
منسوب بہ شراز جو فارس کا ایک مشہور شہر اور مولد و مسکن سعدی علیہ الرّحمتہ و حافظ شیراز ہے۔ ایک قسم کا گولا کبوتر جسکا حلیہ یہ ہے قد بڑا، سینہ چوڑا، آنکھیں بڑی بڑی، سر بڑا، نلیاں موٹی، پنجوں میں پھول یعنی پر پیٹ سفید اور اوپر کے تمام پر مع سر سیاہ یا سبز یا زرد ہوتے ہیں۔شرافت
اِسم مُؤنّث
شریف پن۔ بزرگی۔ بھلمنسائی۔ اشرافت۔ انسانیت۔ آدمیت۔شَرّاٹا
اِسمِ مُذکّر
زور کی آواز۔ شور۔ غل۔ زناٹا۔ ہوا کا سناٹا۔شِراکت
اِسم مُؤنّث
ساجھا۔ شاملات۔ حصہ داری۔ پتّی۔ دشمنی۔ عداوت۔ وہ دشمنی جو باہم ہمسروں یا روشتہ داروں میں ہو۔شِراکت مُساوی
اِسم مُؤنّث
برابر کا ساجھا۔ برابر کی حصہ داری۔شِراکت نامہ
اِسمِ مُذکّر
وہ کاغذ جو شریکوں میں باہم اقرار مدار کی بابت لکھا جائے۔شِراکت کرنا
فعل مُتعدّی
ساجھا ملانا۔ ساجھا کرنا۔ شریک کرنا۔شربت
اِسمِ مُذکّر
پینے کی چیز ۔ مٹھاس میں پکا ہؤا عرق۔ ادویات کا شیرہ ۔ کھانڈ میں پکایا ہؤا۔شربت پلائی
اِسم مُؤنّث
وہ رقم جو دُلہن والوں کو شربت پلا کر حاصل ہوئی ہو۔ وہ نیگ جو دولہا یا دُلہن کی جانب سے نائی کو دیا جائے۔شربت پلانا
فعل مُتعدّی
قند میں گھولا ہؤا پانی نوش کرانا۔ خوشی کی رسم ادا کرنا۔ (ہندو) سگائی کرنا۔ بات ٹھیرانا۔ پان کھلانا۔شَربت کے سے گُھونٹ
اِسمِ مُذکّر
شہد کا سا لطف۔ میٹھے کا گھونٹ۔شَربت کے سے گُھونٹ سمجھ کر پینا
فعل مُتعدّی
کسی ناگوار یا تلخ بات کو حلیمی اور خوشی کے ساتھ برداشت کرنا۔شربت کے پیالے پر نکاح پڑھانا
فعل مُتعدّی
کچھ کٹھراگ نہ کرنا اور غریبوں کی طرح صرف شربت کا پیالہ پلا کر نکاح کر دینا۔شَربتی
اِسم مُؤنّث
ایک طرح کا ہلکا زرد کسی قدر سرخی لیے ہوئے رنگ۔ ہار سنگار اور شہاب ملا کر بنایا ہؤا رنگ۔ ایک قسم کا نگینہ جو  برنگ سُرخی مائل بزردی ہوتا ہے۔ ایک قسم کا میٹھا نیبو جسے میٹھا بھی کہتے ہیں۔ اور بخار میں اکثر چوسا کرتے ہیں۔ ایک قسم کے نہایت باریک اور عمدہ کپڑے کا نام ۔شَرح
اِسم مُؤنّث
بیان۔ اظہار۔ کھولکر کہنا۔ کشایش۔ تفسیر۔ تشریح۔ تفصیل۔ حاشیہ۔ رس کا بھرا ہؤا۔ قیمت مول۔ بھاؤ۔ لگان۔ پڑتا۔شَرح  کرنا
فعل مُتعدّی
مفصل بیان کرنا۔ کھول کر کہنا۔ تفصیل یا تفسیر بیان کرنا۔ تصریح کرنا۔شرح آبپاشی
اِسم مُؤنّث
قانون۔ نہر کا پانی دینے کا نرخ یا معمول۔شَرح بندی
اِسم مُؤنّث
نرخنا۔ نرخ کی فہرست۔شَرح سود
اِسم مُؤنّث
سود کا معمول۔شرح لگان
اِسم مُؤنّث
خراج کا نرخ۔ زمین کی پڑتی۔ بگھوتی۔شَرح کہنا
فعل مُتعدّی
ٹیکا لکھنا۔ تفسیر لکھنا۔شَرر
اِسمِ مُذکّر
آگ کی چنگاری۔ پتنگا۔ پارۂ آتش۔شَرط
اِسم مُؤنّث
عہدو پیمان۔ قول و قرار۔ بچن۔ قول۔ ہوڑ۔ بازی۔ لازم۔ انحصار۔ واجب۔طرز۔ طریق۔شرط باندھنا
فعل مُتعدّی
بازی لگانا۔ عہد کرنا۔ ہاتھ لگانا،۔ ذمہ لینا۔شرط یہ ہے
تابع فِعل
بشرطیکہ۔ اس شرط پر۔ اس اقرار پر۔شرطی
صِفت
مشروط۔ اقراری۔ ضرور۔ بیشک۔ مقرر۔ بلا شبہ۔شرطیہ
صِفت
منسوب۔ شرط ازروے شرط۔ شرطی۔شَرع
اِسم مُؤنّث
راہ راست۔ وہ سیدھا راستہ جو خُدا تعالیٰ نے بندوں کے واسطے نکال کر اُس پر چلنے کا حکم دینا ہے۔ قانونِ محمدیﷺ۔ قانونِ اسلام۔ دین۔ مذہب۔ آئین ۔ دستور۔ راہ۔شرع تورے والی
اِسم مُؤنّث
وہ عورت جو پابند شرع اور قواعد اسلام کی نہایت پابند ہو ( طنزاً بھی کہتے ہیں)۔شَرع محمدی مَہر
اِسمِ مُذکّر
وہ نقدی جو نکاح کے وقت قانون اسلام کے موافق مرد کے ذمہ مقرر ہو۔شَرع محمدیﷺ
اِسم مُؤنّث
قانونِ محمدیﷺ۔ دینِ اسلام کا طریقہ۔شَرع محمدیﷺ نِکاح پڑھانا
فعل مُتعدّی
قانونِ اسلام کے موافق سیدھا سادا نکاح کر دینا۔ جا میں نہ تو زیادہ صرف کیا جاتا ہے اور نہ تزک و احتشام اور باجے گانے کی ضرورت ہوتی ہے۔شَرع میں رخنہ ڈالنا
فعل مُتعدّی
مذہب میں کوئی نئی بات داخل کر کے خلل انداز ہونا۔ مذہبی امور میں جھگڑا نکالنا۔ بدعت کرنا۔شرع میں شرم کیا
کہاوت
جو بات مذہباً جائز ہو اُس میں شرم کرنے سے کیا فائدہ۔ معاملہ میں شرم نہیں چاہئے۔شَرع پر چلنا
فِعل لازِم
دین اسلام اور اس کے قانون کے موافق عامل ہونا۔ ۔ دین محمدیﷺ پر کاربند ہونا۔شرع کے خلاف کرنا
فعل مُتعدّی
قانونِ اسلام کے خلاف کرنا۔ مذہب کے برعکس کرنا۔شَرعاً
تابع فِعل
ازروے شرع۔ قانونِ اسلام کے موافق۔شرعاً جائز ہونا
فِعل لازِم
ازروے اسلام مباح ہونا۔ مذہبے قاعددے کے مطابق درسے ہونا۔شَرعی
صِفت
شرع کے مطابق۔ قانونِ اسلام کے موافق۔ شرع پر چلنے والا۔شرعی داڑھی
اِسم مُؤنّث
شرع کے موافق داڑھی جو لمبان میں ایک بالشت کے قریب ہوتی ہے۔شَرعی قسم
اِسم مُؤنّث
باضابطہ قانون اسلام کے موافق سوگند۔شَرعی پیجامہ
اِسمِ مُذکّر
ٹخنوں سے اونچا پیجامہ۔ اُٹھنگا پیجامہ۔شِرغہ
اِسمِ مُذکّر
سر تا پا بادامی رنگ کا گھوڑا۔شَرف
اِسمِ مُذکّر
بزرگی میں کسی پر فوق لے جانا۔ بزرگواری،۔ برتری۔ فوقیت۔ خوبی۔ بھلائی۔ 
***
شَرف
اِسمِ مُذکّر
بلندی۔ جائے بلند۔ مبارک۔ نیک۔ بزرگی۔ وہ بزرگی جو خانادان یا آبا و اجداد کے سبب ہو۔ شرافت۔ کسی سیّارے کا اپنے اصلی گھر یعنی برج میں آنے کا افتخار۔شَرفِ خدمت
اِسم مُؤنّث
خدمت کرنے یا پاس رہنے کا افتخار۔شَرف لے جانا
فِعل لازِم
فوقیت لے جانا۔ سبقت لے جانا۔ بڑھ جانا۔ آگے نکل جانا۔شَرف ہونا
فِعل لازِم
بزرگی یا شرف حاصل ہونا۔ عزت مِلنا۔ کسی سیّارہ کا اپنے اصلی گھر میں داخل ہونا۔شَرف یاب
صِفت
معزز۔ اعزاز یافتہ۔ شرف حاصل کرنے والا۔شَرق
اِسمِ مُذکّر
طلوع آفتاب۔ اصطلاحی معنی آفتاب نکلنے کی جگہ۔ مشرق۔ پورب۔شَرق سے غرب تک
تابع فِعل
مشرق سے مغرب تک۔ پورب سے بچھم تک۔شَرقی
صِفت
پوربی۔ شرق کا۔ پوربکا ۔ شرق سے نسبت رکھنے ولا۔شَرقی زبان
اِسم مُؤنّث
وہ زبان جر یورپ کے شرق میں بولی جاتی ہے۔ جیسے ایشیائی زبان۔ مثل عربی، چینی، فارسی وغیرہ۔شَرقی عُلوم
اِسم مُؤنّث
وہ علوم مشرق یا ایشیاء میں رائج ہوں۔شَرم
اِسم مُؤنّث
لاج ۔ غیرت۔ حیا۔ حجاب۔ ندامت۔ خیال۔ لحاظ۔ آلہ تناسل و عضومخصوص و شرمگاہ۔ عزت۶۔ حرمت۔شرم بھی نہیں آتی
مُحاورہ
دوست کے نہ آنے کے شکوے یا خلاف بیانی کے جواب میں کہتے ہیں۔شَرم حضوری
اِسم مُؤنّث
سامنے کا لحاظ۔ آنکھ کی شرم۔شرم رکھنا
فِعل لازِم
لاج رکھنا۔ عزت بچانا،۔ بات بنی رکھنا۔شَرم رہ جانا
فعل مُتعدّی
بات رہ جانا۔ عزت قائم رہنا۔ توقیر کیں فرق نہ آنا۔شَرم سے پانی پانی ہونا
فِعل لازِم
شرمندگی سے آب آب ہونا۔ خجالت کے مارے پسینے پسینے ہونا۔شَرم سے گِرنا
فِعل لازِم
شرمندگی یا خجالت کے مارے زمین میں دفن ہو جانے اور مُنہ چُھپانے کو جی چاہے۔ نہایت شرمندہ ہونا۔ ازحد نادم ہونا۔شَرم شَرم میں کام ہوا جانا
فِعل لازِم
لحاظ اور مروت میں کام تمام ہو جانا۔شَرم کرنا
فعل مُتعدّی
شرمانا۔ لحاظ کرنا۔ حجاب کرنا۔ حیا کرنا۔شَرم کی بات
اِسم مُؤنّث
لاج کی بات۔ افسوس کی بات۔ غیرت کی بات۔شَرم کی بَہُو نِت بُھوکی مرے
کہاوت
غیرت مند ہمیشہ نقصان اُٹھاتا ہے۔ جس دُلہن کو کھانے میں شرم ہوتی ہے وہ ہمیشہ بھوکی مرا کرتی ہے۔شرما شرمی
