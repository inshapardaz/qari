سان لگانا۔ تیز کرنا۔ دھار نِکالنا۔ باڑھ رکھنا۔سان نہ گُمان
تابع فِعل
خبر نہ اتر۔ وہم نہ گُمان۔ پتا نہ نشان۔ نافاہ۔ اچانک۔ یکایک۔سان پر چڑھنا
فِعل لازِم
پتھری پر تیز ہونا،۔باڑھ پر رکھا جانا۔ دھار رکھی جانا۔سان چڑھانا
فعل مُتعدّی
سان کے ذریعے سے تیز کرنا۔ دھار رکھنا۔ پتھر چٹانا۔سان گُمان
اِسمِ مُذکّر
وہم و خیال۔سانبھر
اِسم مُؤنّث
ایک جھیل کا نام جو علاقہ جے پور میں واقع ہے۔ اور اس کا پانی از خود نمک بن جاتا ہے۔سانّتھل
اِسم مُؤنّث
ران۔ زانو۔ جانگھ۔سانجھ
اِسم مُؤنّث
شام ۔ مغرب۔ سورج ڈوبنے کا وقت۔ جُھٹ پُٹا۔سانجھ سویرے
اِسم مُؤنّث
صبح شام۔سانجھی
اِسم مُؤنّث
لڑکیوں کا ایک تہوار جو اسوج کے مہینے میں ہوتا ہے۔ اس میں گوبر کی مُورتیں بنا کر شام کو اس کے آگے گیت کاتیں اور اس نام سے گھر گھر مانگتی پھرتی ہیں۔ ۔ ایک فرضی دیوی ۔سانحہ
اِسمِ مُذکّر
واقعہ۔ وقوعہ۔ حادثہ۔ صدمہ۔سانس
اِسم مُؤنّث
نفس۔ دم۔ پُھونک۔ دمہ۔ دمہ کا مرض۔ درز۔ شگاف۔ بھاپ۔سانس اُلٹے لینا
فعل مُتعدّی
دیکھو ( اُلٹے سانس لینا)۔سانس اَڑنا
فِعل لازِم
دم رُکنا۔ دم اٹکنا۔ سانس کا مُشکل سے نِکلنا۔ قریب بمرگ ہونا۔ دمِ واپسین ہونا۔سانس اُکھڑنا
فِعل لازِم
دم اُکھڑنا۔ دم کے تسلسل میں فرق آنا۔ دم نہ سمانا۔ سانس قابو میں نہ رہنا۔سانس بھرنا
فعل مُتعدّی
آہ بھرنا۔ ہارے کرنا۔ اوپر کا دم لینا۔ دم چڑھنا۔ ہانپنا۔ سانس پھولنا۔ اونچے اونچے سانس لینا۔ اخیر سانس پورے کرنا۔سانس رُکنا
فِعل لازِم
دم بند ہونا۔ گلا گُھٹنا۔سانس لینا
فعل مُتعدّی
دم بھرنا۔ سانس کھینچنا ۔ نفس کشیدن کا ترجمہ۔ کِسی طرف کی ہوا کھینچنا یا بھاپ چھوڑنا۔سانس نہ لینا
فعل مُتعدّی
جلد مر جانا۔ دم تک نہ نکالنا۔سانس نہ نِکلنا
فعل مُتعدّی
دم نہ مارنا۔ اُف نہ کرنا۔ خاموش رہنا۔ چُپ سادھنا۔سانس ٹوٹنا
فِعل لازِم
دم ٹوٹنا۔ دم کے تسلسل میں فرق آنا۔سانس ٹھنڈی بھرنا
فعل مُتعدّی
دیکھو( ٹھنڈے ٹھنڈے سانس بھرنا)۔سانس پُھولنا
فِعل لازِم
دم چڑھنا۔ ہانپنا۔ دمہ کا مرض ہونا۔سانس چڑھنا
فِعل لازِم
دم پُھولنا۔ ہونکنی لگنا۔ تھکنا۔ بیدم ہونا۔سانس کا روگ
اِسمِ مُذکّر
دمہ۔ خیق النفس۔سانس کھینچنا
فعل مُتعدّی
دم روکنا۔ دم سدھنا۔ حبس دم کرنا۔ دم چُرانا۔سانسا
اِسمِ مُذکّر
فکر۔ اندیشہ۔ خدشہ۔ سوچ۔ تشویش۔ ڈر۔ خوف۔ دہشت۔ ہیبت۔سانسا چڑھنا
فِعل لازِم
فکر دان گیر ہونا۔ تردُّد پیش آنا۔سانسا کرنا
فعل مُتعدّی
فکر کرنا۔ اندیشہ کرنا۔ چنتا کرنا۔سانن
اِسم مُؤنّث
سانی قوم کی عورت۔ سانی کی جورو۔ ترکاری بولنے کا کام کرنے والی عورت۔ساننا
فعل مُتعدّی
مانڈنا۔ گوندھنا۔ مسلنا۔ ملنا۔ گارا کرنا۔ بھرنا ۔ لتھنا۔ آلودہ کرنا۔ مُلوث کرنا۔ تہمت لگانا۔ شریک حال کرنا۔ پھانسنا۔ مبتلا کرنا۔ رنگنا۔ داغ لگنا۔ کلنک لگنا۔ حرف لانا۔ ۔سانولا
صِفت
سیام برن۔ ملیح۔ سبزہ رنگ۔ نمکین۔ سیاہی مائل۔ کرشن جی کا لقب۔ سیام۔ گندمی رنگ۔سانولا رنگ
اِسمِ مُذکّر
سیاہی لیے ہوئے رنگ۔ ملیح رنگ۔ گندمی رنگ۔سانّولا سلونا
صِفت
نمک والا۔ سانولا۔ حسین و گندمی رنگ والا۔ سبزہ رنگ۔ ملیح۔ پالسہ۔ پھالسہ۔سانولا ہو جانا
فِعل لازِم
کالا پڑ جانا۔ تیرگی چھا جانا۔سانولی صورت
صِفت
ملیح صورت۔ نمکین۔ گندمی رنگ۔ کالی صورت۔سانّولیا
اِسمِ مُذکّر
کرشن جی کا لقب جو ناگ کی پُھنکار سے کالے پڑ گئے تھے۔سانوٹا
صِفت
 ہوشیار،۔ ہوش حواس سے درست۔ لَیس۔ مستعد۔ آمادہ۔ موجود۔ مقابل۔ سامنے۔ چوکنا۔سانوٹا ہو جانا
فِعل لازِم
ہوشیار اور چوکس ہو جانا۔ آمادہ و مستعد ہو جانا۔ سامنے ہو جانا۔ سنبھل جانا۔سانّٹ
اِسم مُؤنّث
گانٹھ۔ گرہ۔ عقدہ۔ سازش۔ باہم مل جانا۔ بندش۔ دُشمنی۔ سنجوگ۔ ملاپ۔ اتفاق۔سانّٹ لگانا
فعل مُتعدّی
گِرہ لگانا۔ تاگا جوڑنا۔سانٹ لینا
فعل مُتعدّی
مِلا لینا۔ شریک کر لینا۔ یار بنا لینا۔ سازش کر لینا۔ باہم ساز کر لینا۔سانّٹا
اِسمِ مُذکّر
چابک۔ چمڑے کا تسمہ بندھی ہوئی لکڑی جس سے بیل ہانکتے ہیں۔ انکس۔ آر۔سانّٹنا
فعل مُتعدّی
مِلانا۔ گانٹھنا۔ شریک کرنا۔ یار بنانا۔ دوست بنانا۔ چسپاں کرنا۔ نتھی کرنا۔ مُنسلک کرنا۔ اُلجھانا۔ گانٹھ۔ تاگا جوڑنا۔سانپ
اِسمِ مُذکّر
سرب۔ ناگ۔ مار۔ اجگر۔ اژدر۔ کیڑا۔ اسّی۔سانپ سا لہرانا
فِعل لازِم
سانپ کی طرح جُنبش کرنا۔ سانپ کا جھومنا۔ صدمہ گُزرنا۔ افسوس کرنا۔ اضطراب ہونا۔سانپ سب جگہ ٹیڑھا چلتا ہے۔ اپنے بِل میں سیدھا جاتا ہے
کہاوت
بڑا آدمی دب جگہ نٹ کھٹی کرتا ہے مگر گھر میں سیدھا ریتا ہے۔سانپ سونگھ جانا
فِعل لازِم
سانپ کا ڈس جانا۔ سانپ کا کاٹ جانا۔ سانپ کا زہر چڑھ جانا۔سانپ مرے نہ لاٹھی ٹوٹے
کہاوت
کام نِکل آئے مگر ضرر نہ ہو۔سانپ نہیں جو مٹّی چاٹ کر رہیں
کہاوت
ہر شخص اپنی ہی خوراک کھا سکتا ہے اُس میں صرفہ ناممکن ہے۔سانپ والا
اِسمِ مُذکّر
سپیرا۔ سانپ کا کھلاڑی۔سانپ چھاتی پر پھرنا
فِعل لازِم
بڑا صدمہ گُزرنا۔ دل پر چوٹ لگنا۔ نہایت افسوس کرنا۔ ملولا آنا۔ تلملاہٹ ہونا۔ اضطراب ہونا۔  رشک گُزرنا۔ آگ میں لوٹنا۔ حسرت آنا۔سانپ کا بچہ سپولیا
کہاوت
بُرے آدمی کی اولاد بھی بُری یا شریر کا بچہ بھی شریر ہی ہوتا ہے۔سانپ کا تماشا
اِسمِ مُذکّر
وہ تماشا جو سپیرے پونگی بجا کر سانپ کا خوش کر کے دکھا تے ہیں۔سانپ کا سر ہی کُچلا کرتے ہیں
کہاوت
موذی کو جیتا ہی نہیں چھوڑتے۔ شر انگیز کی شامت آتا ہی کرتی ہے۔سانپ کا من
اِسمِ مُذکّر
سانپ کا دل جس کی نسبت عوام کا خیال ہے کہ وہ چودھویں رات کے چاند کی طرح چمکتا ہے اور جس کے ہاتھ لگتا ہے اُسے بادشاہ بنا دیتا ہے۔ بلکہ تمام آفات، ضرر و نقصان وغیرہ سے بچا ددیتا ہےمشہور ہے کہ جب سانپ خوش ہوتا ہے تو رات کے وقت اُسے مُنہ سے نکال کر جنگل میں رکھتا اور کوسوں اس کی روشنی میں سیر کرتا پھرتا ہے۔ غرض یہ سب کہانیاں ہیں۔سانپ کا کاٹا
صِفت
سانپ کا ڈسا ہؤا۔ مارِ گزیدہ۔سانپ کا کاٹا رسی سے ڈرتا ہے
کہاوت
جو شخص موذی سے تکلیف اُٹھاتا ہے وہ ہمیشہ اس ہمشکل دوسرے سے ڈرتا ہے۔ صدمہ رسیدہ کو ذرا سا صدمہ بھی ڈرا دیتا ہے۔سانپ کھلانا
فعل مُتعدّی
سانپ کو جادو یا منتر کے زور سے تسخیر کرنا۔ بہلانا۔ سانپ کو پُھسلانا۔ نافہم مغلوب المغضہ مردم آزار آقا کی نوکری کرنا۔سانپ کی سی لہر
اِسم مُؤنّث
سانپ کے کاٹے کا۔ مار گزیدہ کی سی جنبش۔ سانپ کے کاٹے کا اثر۔ روراہٹ۔سانپ کی سی کینچلی جھاڑنا
فعل مُتعدّی
نِکھرنا۔ رنگ نِکلنا۔ صاف سُتھرا بننا۔ پر پُرزے نکلنا۔سانپ کی لکیر
اِسم مُؤنّث
وہ نشان جو سانپ کے نکل جانے پر رہتا ہے۔ سانپ کے پیٹ کا نشان جو چلتے وقت پڑتا ہے۔سانپ کے مُنہ میں
تابع فِعل
معرض ہلاکت میں ۔ خطرناک جگہ میں۔ جان جوکھوں میں۔سانپ کے مُنہ میں چھچوندر نِگلے تو اندھا اُگلے تو کوڑھی
کہاوت
اِدھر کنّواں اُدھر کھائی ہر طرح ضرر ہی ضرر۔سانپ کے نیچے کا بِچھو
اِسمِ مُذکّر
موذی اور ظالم آدمی  نہایت زہر دار کژدم جس نے سانپ کے نیچے پرورش پائی ہو۔سانپ کے پاؤں پیٹ میں ہوتے ہیں
کہاوت
بد ذات کی بدی ظاہر نہیں ہوتی۔ فتنہ انگیز کی باتیں پیٹ میں ہؤا کرتی ہیں۔سانپسا لاہوری
صِفت
چونکہ لاہور کے کھریوں میں مُدت دراز تک مُردے کا ماتم رہتا ہے اس سبب سے بڑے ماتم یا سوگ کو لاہوری سانپے سے نسبت دیتے ہیں۔سانّپن
اِسم مُؤنّث
ناگن۔ مادہ مار۔ دو مونہی سانپ۔ ایک لمبی بالوں کی لکیر یا بھونری جو بعض آدمیوں کی پُشت پر اور گھوڑے کے کندھے کی جڑ میں ہوتی اور منحوس خیال کرتے ہیں۔سانّپنا
اِسمِ مُذکّر
ماتم ۔ سوگ۔ نوحہ۔ مُردے کا سوگ۔ ستاپ۔ بد دعا۔ گریہ و زاری۔ رونا پیٹنا۔سانپنا پڑنا
فِعل لازِم
ماتم پڑنا۔ کُہرام مچانا۔ واویلا ہونا۔سانپنا کرنا
فعل مُتعدّی
نوحہ کرنا۔ میّت پر رونا۔سانپوں
اِسمِ مُذکّر
سانپ کی جمع۔سانپوں کی سبہا میں جیبھوں کی لپالپ
کہاوت
بُروں کے بُرے ہی کام ۔ موذیوں کی محفل میں تکلیف ہی کا چرچا۔سانپے جانا
فِعل لازِم
ماتم کے واسطے جانا۔ شریکِ ماتم ہونا۔سانپے کی تیل
اِسم مُؤنّث
وہ پوشاک یا لباس جو غریب عورت ایک دفعہ دام لگا کر بنا لیتی ہے اور ہر ایک تقریب میں علے الخصوص ماتم میں جہاں بہت سی عورتیں جمع ہوتی ہیں۔ اُسی کو پہن کر جاتی ہے۔ تاکہ عزت میں بٹہ نہ لگے۔ تہوار کی پوشاک۔ دکھانے کا لباس۔سانچ
اِسمِ مُذکّر
سچ۔ صدق۔ ست۔ راستی۔ صحیح۔ درُست۔ ٹھیک۔سانچ کو آنچ نہیں
کہاوت
سچ کو جوکھوں نہیں۔ ایمان کو ضرر نہیں۔ سچ ہمیشہ تِرتا ہے۔سانّچا
اِسمِ مُذکّر
سچّا۔ صادق ۔ راستگو۔ قالب۔ دھات کی چیز یا کھانڈ وغیرہ کے کھلونے ڈھانے کا اوزار۔ ڈھانچا۔ بچہ دان۔ کوکھ۔ دھرن۔سانّچی
صِفت
راست۔ سچی۔ ٹھیک۔ درست۔ صحیح۔ واقعی۔سانّچے
اِسمِ مُذکّر
سانچا کی جمع۔سانچے میں ڈھالنا
فعل مُتعدّی
قالب میں ڈال کر بنانا۔ سڈول اور خوبصورت بنانا۔ خوش ترکیب اور خوش قطع بنانا۔سانچے میں ڈھلنا
فِعل لازِم
قالب میں بنایا جانا۔ خوبصورت بنانا۔ تراشیدہ ہونا۔ تراش خراش حاصل کرنا۔ خیراد چڑھنا۔سانچے کی سچّی
اِسم مُؤنّث
مرد کے نطفے کوع ضایع نہ ہونے دینے والی عورت۔ وہ عورت جسے پہلے ہی جماع میں ہر دفعہ حمل رہ جائے۔سانڈ
اِسمِ مُذکّر
بدھیا کا نقیض۔ آنڈو۔ خُصیہ دار۔ بِجار۔ وہ بہل یا گھوڑا جو بچے دلوانے کے واسطے رکھیں۔ نر گاؤ۔ فربہ۔ جسیم۔ شحیم ۔ موٹا تازہ۔ غم و فکر سے آزاد۔ بے فکرا۔سانڈا
اِسمِ مُذکّر
گوہ کی قسم کا ایک جانور جس کا تیل طلائے قضیب یا گٹھیا کے واسطے نکالا جاتا ہے۔ ظالم سانڈا۔سانڈنی
اِسم مُؤنّث
اونٹنی۔ ناقہ۔ قدمباز اور تیز رفتار سواری کی اونٹنی۔ یا اونٹ۔سانڈنی سوار
اِسمِ مُذکّر
ناقہ سوار۔ شتر سوار۔ نامہ بر۔ پیغامبر۔سانڈیا
اِسمِ مُذکّر
اونٹ کا بچہ۔ گوٹا بُننے کا تُر۔ گوٹے کا بیلن۔سانک
اِسم مُؤنّث
شاخ۔ ساق۔ ٹہنی۔ 
