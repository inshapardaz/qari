روپے کا چوتھا حصہ۔ پاؤلا۔ 
***
سوکا
صِفت
وہ فصل جو ادلوں سے مر جائے۔سَوکن
اِسم مُؤنّث
دیکھو ( سوت)۔سوکنا
فعل مُتعدّی
ایک دفعہ ہی پی جانا۔ چڑھا جانا۔ ڈکار جانا۔ جذب کر لینا۔سَوکنوں کی جوڑی
اِسم مُؤنّث
ایک قسم کی آتشبازی جو چھوٹتے وقت بہم ٹکراتی ہے۔سوکھ کر
تابع فِعل
خُشک ہو کر۔ نمی دور ہو کر۔سُوکھ کر پنجر ہو جانا
فِعل لازِم
اس قدر لاغر ہو جانا کہ ہڈّیاں پسلیاں نکل آئیں۔ نہایت دُبلا ہو جانا۔ بدن پر گوشت نہ رہنا۔سُوکھ کر کانٹا ہو جانا
فِعل لازِم
سوکھ کر لعات ہو جانا۔ نہایت دُبلا ور لاغر ہو جانا۔ تنکا سا ہو جانا۔سُوکھ کر کانّٹا ہونا
فِعل لازِم
نہایت لاغر ہونا۔ دُبلا۔ نحیف۔ ضعیف۔ کمزور۔ ناتواں ۔سُوکھ کر ہدف ہونا
فِعل لازِم
دیکو (سُوکھ کر کانّٹا ہونا)سُوکھا
صِفت
خُشک شدہ۔ نمی یا رطوبت دُور شُدہ۔ سُکڑا ہؤا۔ جھریاں پڑا ہؤا۔ پتلا۔ لاغر۔ تاگا۔ ٹیڑی۔ روکھا،۔ پھیکا۔ قحط سالی۔ خشک سالی۔ کال۔ بھنگ۔سُوکھا جواب
اِسمِ مُذکّر
روکھا جواب۔ خُشک جواب۔ صاف اِنکار۔سُوکھا جواب دینا
فعل مُتعدّی
صاف انکار کرنا۔ مطلق جواب دینا۔ کانوں پر ہاتھ رکھ جانا۔سوکھا سا
صِفت
دُبلا پتلا۔ لاغر۔ تِنکا سا۔ سوکھا سا۔سُوکھا سہما
صِفت
دُبلا پتلا۔ لاغر۔ چُپ چُپ۔ خوف زدہ۔سُوکھا لگنا
فِعل لازِم
دُبلا ہوتا جانا۔ لاغر و نحیف ہوتا جانا۔ غم یا بیماری کے باعث بدن کا سوکھتا جانا۔ دق ہو جانا۔سُوکھا ٹالنا
فعل مُتعدّی
بے نیل مرام ، واپس کرنا۔ خشک جواب دینا۔ صاف انکار کرنا۔ مسلوک نہ ہونا۔ باتوں میں ٹالنا۔سوکھا ٹھنٹھ
اِسمِ مُذکّر
خشک شدہ درخت۔ نہایت سوکھا ہؤا اور بِن پتّوں۔ بغیر شاخوں کو درخت۔سُوکھا پڑنا
فِعل لازِم
قحط پڑنا۔ قحط سالی ہونا۔ کال پڑنا۔سُوکھنا
فِعل لازِم
خُشک ہونا۔ بے نم ہو نا۔ رطوبت نہ رہنا۔ دُبلا ہونا۔ لاغر ہونا۔ دیر لگنا۔ جذب ہونا۔ چوسنا۔ سڑپنا۔ سڑکنا۔ چڑھانا۔سُوکھی
صِفت
خُشک شُدہ۔ کھڑنک۔ بِن لاون کی۔ روکھی۔ خالی خولی۔ دُبلی پتلی۔ لاغر۔ ناتواں۔سُوکھی اَلفن
اِسم مُؤنّث
دُبلی پتلی الف کی مانند عورت۔سُوکھی روٹی
اِسم مُؤنّث
نانِ خُشک۔سُوکھی سہمی
اِسم مُؤنّث
دُبلی پتلی۔ خوف زدہ۔ خائفہ۔سوکھے
صِفت
خُشک شدہ، سوکھا کی جمع۔سُوکھے دھان
اِسمِ مُذکّر
دھانوں کا کھیت جو دھوپ کی تیزی سے جل  گیا ہو۔سُوکھے دھانوں پر پانی پڑنا
فِعل لازِم
عین وقت پر یا حسب خواہش نہ برسنا۔ تنت پر بارش ہونا۔ تر و تازہ ہونا۔ شادابی حاصل ہونا۔ جی جانا۔ جان پڑ جانا۔ مُراد بر آنا۔ وقت پر کام نِکلنا۔ فلاحت کی امید بندھنا۔سُوکھے ساون رُوکھے بھادوں
کہاوت
سدا بے فیض۔سُوکھے ٹکڑوں پر کوّوں کی مہمانی
کہاوت
ناداری میں عیش کی باتیں۔ مفلسی میں شیخی۔سُوکھے ٹکڑوں پر کوّے اُڑانے
کہاوت
تھوڑی سی تنخواہ اور یہ بےعزتی کا کام ۔سُوکھے کا آزار
اِسمِ مُذکّر
مرضِ دق۔ بڑی بیماری۔ سوکھا۔سُوکھے گھاٹ اُتارنا
فعل مُتعدّی
سوکھا ٹالنا۔ مایوس رکھنا۔ محروم رکھنا۔ یونہیں ٹالنا۔سوگ

ماتم۔ مصیبت۔ غم و اندواہ۔ چنتا۔ فکر۔ سوچ۔ اُداسی۔ سیاپا۔ وہ غم جو مردے کے مرنے پر ہر قوم کے دستور کے موافق کیا جاتا ہے۔سوگ اُتارنا
فعل مُتعدّی
ماتم دور کرنا۔ سوھ اُٹھانا۔ سیاپے سے نِکلنا۔سوگ رکھنا
فعل مُتعدّی
میّت کا غم کرنا۔ ماتم کرنا،۔ سیاپا رکھنا۔ ماتم داری کرنا۔ مُردے کے بعد چالیس دن تک کوئی خوشی کی بات نہ کرنا۔سوگ لیکر بیٹھنا
فِعل لازِم
ماتم اختیار کرنا۔ رسوم ماتم کا پابند ہونا۔سوگ وار
صِفت
غمگین۔ غم زدہ۔ رنجیدہ۔ ملول۔ اندوہناک۔ غم خوار۔ ماتمی۔سوگ کرنا
فعل مُتعدّی
ماتم کرنا۔ غم کرنا۔ رنج میں رہنا۔سَوگند
اِسم مُؤنّث
قسم ۔ کِریا۔ سُوں۔ عہد۔ حلف۔سَوگند دلانا
فعل مُتعدّی
قسم دینا۔ قسم کھلانا۔ عہد کرانا۔سَوگند کھانا
فعل مُتعدّی
قسم کھانا۔ عہد کرنا۔ حلف اُٹھانا۔سَوگندا سوگندی
اِسم مُؤنّث
قسماقسمی۔ عہدو پیمان۔ قول اقرار۔سوگی
صِفت
غمگین۔ مغموم۔ مصیبت زدہ۔ ملول۔ رنجیدہ۔ ماتم زدہ۔ ابرک کی ٹٹیاں۔ آرائش جو ہندؤں میں بیاہ کے ساتھ جاتی ہے۔سُوں
اِسم مُؤنّث
قسم ۔ سوگند۔ حلف۔ عہد۔ پیمان۔سُوں سُوں
اِسم مُؤنّث
سانس کی آواز کو ناک سے نکلے۔سُوں سُوں کرنا
فعل مُتعدّی
ناک سے سانس لینا۔ ہانپنے کی آواز۔سُوہا
صِفت
لال۔ سُرخ۔ قرمزی۔ بھیروں راگ کی بھارجا جو گنوار کاتک میں صبح کے وقت گاتے ہیں۔سوہان
اِسمِ مُذکّر
ریتی، لکڑی یا لوہا صاف کرنے کا خاردار آلہ۔سوہانِ روح
صِفت
آزار دہندہ جان۔ گراں خاطر۔سَوہرا
اِسمِ مُذکّر
دیکھو سورا بمعنی سُسرا۔سوہلا
اِسمِ مُذکّر
دیوی کی تعریف کا گیت۔ تعریف کا گیت۔سوہلے
اِسمِ مُذکّر
سُوہلا کی جمع۔ دیوی کی تعریف کے گیت۔ ۔سوہن
اِسمِ مُذکّر
سوہان کا مخفف۔ ریتی۔سُوہنا
فِعل لازِم
زیب دینا۔ پھبنا۔ اچھا دکھائی دینا۔ موزوں ہونا۔سُوہنی
صِفت
خوبصورت۔ خوشنما۔ دلفریب۔ جھاڑو۔ بُہاری۔سوہی

وہ ہی۔ جوہی۔ ویسا ہی۔سویا
اِسمِ مُذکّر
ایک خوشبودار ساگ کا نام جسے فارسی میں شود کہتے ہیں۔ 
***
سَویا
اِسمِ مُذکّر
سوا کا پہاڑا۔ ایک قسم کا گیت۔سویا اور چوکا
کہاوت
یعنی غافل ہؤا اور خطا کھائی۔سِوَیّاں
اِسم مُؤنّث
ایک قسم کی خوراک جو گیہوں کے میدہ کو گوندھ کر تار کی مانند بنائی جاتی ہیں۔ مسلمانوں میں عید کو اور ہندؤں میں سلونوں کے تہوار پر بالخصوص پکا کر کھائی جاتی ہیں۔سِویّاں بَٹنا
فعل مُتعدّی
سِویّاں بنانا۔سِوَیّاں جھیلنا
فعل مُتعدّی
گھوڑے یا ہاتھی کی سویّوں کو احتیاط کے ساتھ اُٹھا اُٹھا کر پھیلانا۔سُویدا
اِسمِ مُذکّر
وہ نقطۂ سیاہ جو دل پر ہو۔سویر
صِفت
اوّل ۔ پہلے۔سویرا
اِسمِ مُذکّر
اوّل وقت۔ صبح۔ تڑکا۔ سحر۔ طلوع آفتاب سے پہلے کا وقت۔سویرا ہونا
فِعل لازِم
صبح ہونا۔ پو پھٹنا۔ تڑکا ہو جانا۔ دن چڑھ جانا، سورج سر پر آ جانا۔ تڑکا ہونا۔ آنکھوں کے آگے چکا چوند آ جانا۔سُویمبر رچنا
فعل مُتعدّی
خاوند کی انتخاب کی مجلس جمع کرنا۔سُویمبرا
اِسم مُؤنّث
اپنے آپ خاوند اخذ کر لینے والی لڑکی۔سٹ سٹ
اِسم مُؤنّث
دیکھو ( سٹاسٹ)۔سٹ لڑانا
فعل مُتعدّی
گٹھنا۔ جگت لگانا۔ ربط پیدا کرنا۔ یارانہ گانٹھنا۔ آشنائی کرنا۔ آنکھ لگانا۔سِٹّا
فعل مُتعدّی
جوار کی بوندی۔ جوار کا خوشہ۔ جوار کا بُھٹا۔ وہ اقرار نامہ جو کاشتکار باہمی کشت کی بابت لکھ لیں۔ شراکت۔ کھیت کا ساجھا بٹائی۔سٹّا بٹّا
اِسمِ مُذکّر
اٹ سٹ۔ ساز باز۔ سازش۔ میل ملاپ۔ فریب و دغا۔سٹابری

دیکھو ( اسٹابری)۔سٹاسٹ
اِسم مُؤنّث
برابر کوڑے مارنے کی  آواز۔ لگاتار قمچیوں کے مارنے کی آواز۔ متواتر۔ پٹاپٹ۔سٹامپڈ
صِفت
ٹکٹ چسپاں۔ ٹکٹ لگایا ہؤا۔ پیڈ۔سٹانا
فعل مُتعدّی
ملانا۔ بھڑانا۔ جوڑنا۔ چسپاں کرنا۔سٹاؤ
اِسمِ مُذکّر
چسپیدگی۔سٹاک
اِسم مُؤنّث
سڑاک۔ چھڑی مارنے کی آواز۔سٹر پٹر
اِسم مُؤنّث
چھوٹا موٹا کام،۔ ادنیٰ ادنیٰ کام۔ ذرا ذرا سے کام۔سٹر پٹر کرنا
فعل مُتعدّی
چھوٹے موٹے کام کرنا۔ بکھیڑا پھیلانا۔ بیکار پھرنا۔سٹرپٹر لگانا
فعل مُتعدّی
چھوٹے موٹے کام کرنا۔ الجھیڑا لگانا۔ بکھیڑا پھیلانا۔سٹلّو
اِسم مُؤنّث
بیہودہ عورت۔ بے سلیقہ عورت۔ پھوڑ عورت۔ احمق عورت۔سٹنا
فِعل لازِم
سازش کرنا۔ مل جانا۔ چپکنا۔ جُڑنا۔ وصل ہونا۔سٹپٹا جانا
فِعل لازِم
گھبرا جانا۔ حواس باختہ اور بے اوسان ہونا۔سٹپٹاتے پھرنا
فِعل لازِم
حیران و سوگرداں پھرنا۔ مارا مارا پھرنا۔ گھبرایا ہؤا پھرنا۔سٹپٹانا
فِعل لازِم
گھبرانا۔ چھکّے چھوٹنا۔ حواس باختہ ہونا۔ بے اوسان ہونا۔سٹک
اِسم مُؤنّث
پتلی چھڑی۔ چھڑ۔ بید۔ پتلی عورت۔ چھریر سے بدن کی عورت۔ دُبلی پتلی عورت۔ پتلا سانپ۔سٹک جانا
فِعل لازِم
کھسک جانا۔ لوگوں کو غافل پا کر چپکے سے نکل جانا۔ سُک کی طرح جلدی سے چلا جانا۔ کافور ہو جانا۔سٹکنا
فِعل لازِم
کھسکنا۔ فرار ہونا۔ روپوش ہونا۔ رفو چکر ہونا۔ ہوا ہونا۔سٹھ
صِفت
ساٹھ کا مُخفف۔ ۔ جاہل۔ بیوقوف۔ اناڑی۔ نادان۔سٹھ جانا
فِعل لازِم
کہن سالی کے باعث حواس خمسہ میں فتور آ جانا۔ پیرانہ سالی کے باعث بہک جانا۔ بیوقوف ہو جانا۔سٹھورا
اِسمِ مُذکّر
وہ میٹھا جو زچہ کے واسطے سونٹھ اور میوہ وغیرہ ڈال کر بیانا جاتا ہے۔ حلواے سخت۔سٹِھی
اِسم مُؤنّث
وہ نہایت موٹے اور لال رنگ کے چاول جو ساٹھ رز کے عرصہ میں بوئے جوتے جاکر تیار ہو جاتے ہیں۔ ایک قسم کے موٹے چاول۔ 
***
سِٹھی
اِسم مُؤنّث
وہ گالیاں جو بیاہ میں سمدھنیں ایک دوسری کو باہم دیتی ہیں۔ اور نیز فحش بنائے ہوئے گیت جو بیاہ میں ڈومنیاں سمدھنوں کی طرف سے ایک دوسرے کی نسبت سناتی ہیں۔سٹھیانا
فِعل لازِم
ساٹھ برس سے اوپر کا ہو جانا۔ کُہن سالی کے باعث حواس باختہ ہو جانا۔ عقل کا جاتا رہنا۔  عقل میں فتور آنا۔سِٹی
اِسم مُؤنّث
حواس۔ اِندری۔ گیان۔ اوسان۔ ہوش۔ عقل۔سِٹی بُھولنا
فِعل لازِم
اوسان جاتے رہنا۔ حواس باختہ ہونا۔ گھبرا جانا۔ اٹپتا جانا۔ بوکھلا جانا۔ ہوش نہ رہنا۔سِٹی گم ہونا
فِعل لازِم
دیکھو ( سٹی بھولنا)۔سَٹیا
اِسم مُؤنّث
حقارتاً و ازروے غضب۔ بیٹی۔ بیٹا۔سٹیل
اِسم مُؤنّث
فولاد۔ اسپات۔ لوہے کی قلم۔ فولادی قلم۔سِپّا
اِسمِ مُذکّر
نشانہ۔ ہدف۔ ڈھب۔ ڈھنگ۔ ٹپس۔ پلّہ۔ مار۔ فاصلہ۔ مسافت۔ سُراغ۔ کھوج۔سِپّا لڑانا
فعل مُتعدّی
ٹپّس جمانا۔ ڈھب لگانا۔ ڈھنگ ڈالنا۔ پنیری جمانا۔سِپّا لڑنا
فِعل لازِم
موافقت ہونا۔ پلول مِلنا۔ رسائی ہونا۔ پُہنچ ہونا۔ موقع مِلنا۔ ڈھب بنّا۔ ساجھا لڑنا۔ آشنائی ہونا۔ دل لگی ہونا۔ آنکھ لگنا۔سُپارا
اِسمِ مُذکّر
سِر ذکر۔ حشفہ۔ قضیب کی ٹوپی۔سِپارہ
اِسمِ مُذکّر
قُرآن شریف کا ہر ایک تیسواں حصہ۔سُپاری
اِسم مُؤنّث
اچھالیا۔ کیلی۔ فُوفل۔ پھال۔ 
***
سُپاری
اِسم مُؤنّث
دیکھو ( سپیاری)۔سِپاس
اِسم مُؤنّث
شُکر۔ منّت۔ شُکر گزاری۔ اظہار احسانمندی۔  منّت شناسی۔ اعترافِ نعمت۔سِپاس نامہ
اِسمِ مُذکّر
ایڈرس۔ ( وہ تحریری شُکریہ جو کِسی حاکم کر رُخصت یا تبدیل ہوتے وقت اُس کی کار گزاری کے منّت پذیر ہونے میں دیتے ہیں۔سِپاس گُزاری
اِسم مُؤنّث
 اظہار احسانمندی۔  منّت شناسی۔ اعترافِ نعمت۔سَپّاٹ
صِفت
صاف۔ سادہ۔ سلپٹ۔ یلساں۔ چورس۔ برابر۔ ہموار۔سپاٹ ہونا
فِعل لازِم
گِھس کر یکساں ہونا۔ ہموار ہونا۔سپاٹا 
اِسمِ مُذکّر
دروڑ۔ جھپٹ۔ طرارہ۔ سیر۔ تماشا۔سپاٹا بھرنا
فعل مُتعدّی
طرارہ بھرنا۔ دوڑ لگانا۔ پرندے کا اُڑ جانا۔سِپاہ
اِسم مُؤنّث
فوج۔ لشکر۔ کٹک۔سِپاہ گری
اِسم مُؤنّث
سپاہی کا کام یا پیشہ۔سِپاہی
اِسمِ مُذکّر
جنگی آدمی۔ فوجی آدمی۔ پیادہ۔ لشکری۔ چپراسی۔ برقنداز۔ مذکوری۔ سنتری۔ کانسٹیبل۔سپاہی کا پُوت
اِسمِ مُذکّر
سپاہی زادہ۔سِپاہیانہ

سپاہیوں کے موافق۔ دلیرانہ۔ بہادرانہ۔ چُستی کے ساتھ۔ پُھرتی سے۔سِپر
اِسم مُؤنّث
ڈھال۔ پھری۔ آفتابی۔ آڑ۔ حفاظت۔ پناہ۔ روک۔ سرن۔سِپر پھینکنا
فعل مُتعدّی
ہتھیار دالنا۔ ڈھال پھینکدینا۔ عاجز ہونا۔ مغلوب ہونا۔ ُپشت دکھانا۔سپر ہونا
فِعل لازِم
آڑ ہونا۔ ہدف بننا۔ آرے آنا۔ سامنے آنا۔ دیوار بنانا۔سِپُرد
اِسم مُؤنّث
تفویض ۔ تحویل۔ حوالہ۔ سونپنا۔ امانت۔سپُرد کرنا
فعل مُتعدّی
سونپنا۔ امانت رکھنا۔ حوالہ کرنا۔ ہاتھ میں ہاتھ دینا۔ حراست کرنا۔ نظر بند کرنا۔سپُرد گئے مال
اِسم مُؤنّث
مال سونپنا۔ تحویلِ دولت۔سپُرد ہونا
فِعل لازِم
سونپا جانا۔ حوالہ ہونا۔ ذمّہ ہونا۔ نظر بند ہونا۔سَپردا
اِسمِ مُذکّر
ڈھاڑی۔ سازندے۔ ناچنے والی کے ساتھ والے جو طبلہ و سارنگی بجاتے ہیں۔ ڈوم۔ بھڑوے۔سپُردگی
اِسم مُؤنّث
تحویل۔ حوالگی۔ حوالات۔ حراست۔ نظر بندی۔سُپرنٹنڈنّٹ
اِسمِ مُذکّر
نگراں۔ محافظ۔ نگہباں۔ منتظم۔ سربراہ کار۔ ناظر۔سِپستان
اِسمِ مُذکّر
لسورا۔ مخاط۔سُپنا
اِسمِ مُذکّر
رویا ۔ خواب۔ سوتے میں جو کُچھ نظر آئے اُسے سُپنا کہتے ہیں ۔ خیال۔ وہم۔سِپند
اِسمِ مُذکّر
دیکھو ( اسپند)۔سَپُوت
اِسمِ مُذکّر
سعادت مند بیٹا۔ لائق بیٹا۔ فرزندِ رشید۔  اہل لڑکا۔ اچھا لڑکا۔ ماں باپ کا فرماں بردار۔ طنزاً  نالائق اور ناخلف بیٹا۔سَپُوتی
صِفت
سعادت مند اور لائق اولاد والی۔ سات بیٹیوں والی۔سپُورن
صِفت
بھرا ہؤا۔ معمور۔ بھر پور۔ سیر۔ گھایا۔  آسودہ۔ سارا۔ تمام۔ کُل۔سَپولیا
اِسمِ مُذکّر
سانپ کا تازہ نکلا ہؤا بچہ۔سُپھل
صِفت
اچھا پھل۔ عمدہ نتیجہ۔ فائدہ مند۔ زرخیز۔ سیر حاصل۔ شاداب۔سِپہ
اِسم مُؤنّث
سپاہ۔ فوج۔ لشکر۔سپہ سالار
اِسمِ مُذکّر
فوج کا سب سے بڑا افسر۔ جرنل۔ کمانیر۔ کمانڈر انچیف۔ جنگی لاٹھ۔سپہ گری
اِسمِ مُذکّر
دیکھو ( سپاہ گری)۔سَپید
صِفت
سفید۔ دھولا۔ اُجل۔ اُجلا۔ سیت۔ چِٹّا۔ براق۔ گورا۔ کورا۔ سادہ۔ بِن لکھا۔سپید و سیاہ کرنا
فعل مُتعدّی
سیاہ و سفید کرنا۔ بُرا خواہ بھلا کہنا۔سُپیدہ
اِسمِ مُذکّر
پھونکا ہؤا جست خواہ رانگ جسے اکثر آنکھوں کی دوا اور وارنس وغیرہ میں ڈالتے ہیں۔سَپیرا
اِسم مُؤنّث
سفیدی۔ قلعی۔ پتھر کا پھوکا  ہؤا چونہ۔ سنگِ مرمر کا چونہ۔ بیاض۔ دھالا پن۔ صباحت۔ روشنی۔ جوت۔ نور۔سچ
صِفت
راست۔ ٹھیک۔ حق۔ درست۔ صحیح۔ صدق۔ ست۔ بجا۔ البتہ۔ واقعی۔ تحقیق۔ فی الواقع۔ بیشک۔ بلا شُبہ۔سچ مُچ
تابع فِعل
بعینہٖ۔ بے کم و کاست ہُو بہو۔ عین مین۔ بے شک۔ بلا شُبہ۔ یقیناً۔ بالکل صحیح۔ در حقیقت۔سچ کا زمانہ نہیں
کہاوت
سچ کا کوئی اعتبار نہیں کرتا۔ جھوٹ کا دور دورا ہے۔سچ ہے
مُحاورہ
بجا ہے۔ درست ہے۔ ٹھیک ہے۔سَچّا
صِفت
راست گو۔ راستباز۔ صادق۔ درست۔ ٹھیک۔ خالص۔ کھرا۔ بے کھوٹ۔ اچھوتا۔ نرمل۔ ایماندار۔ سیدھا۔ بے کپٹ۔ صاف دل۔ مُخلص۔ اصلی۔ جواہر۔سچا بیوہار
اِسمِ مُذکّر
سچا کاروبار اور ٹھیک ٹھاک معاملہ۔ سیدھی سیدھی بات۔ کھرا کھرا حساب۔سچّا جوڑا
اِسمِ مُذکّر
کھرا کا مدار جوتا۔ کھرے کام کا چوڑیوں کا جوڑا۔سچّا موتی
اِسمِ مُذکّر
اصلی موتی۔ وہ کھرا موتی جو صدف کے اندر سے نکلا ہو۔سچّا پن
اِسمِ مُذکّر
صداقت۔ راستبازی۔ ایمانداری۔ دیانت داری۔ ثابت قدمی۔ وفاداری۔سچّا ہاتھ
اِسمِ مُذکّر
لین دین کاکھرا پن۔ دیانت داری۔ معاملہ کی صفائی۔سَچّل
صِفت
جُھٹل کا نقیض۔ اصل اصل۔ ٹھیک ٹھیک۔ بالکل درست۔سچّل سچّل بولنا
فعل مُتعدّی
سچ سچ کہنا۔ کھری کھری کہنا۔ بے لاگ لپٹ کہنا۔ کھرتل سُنانا۔سُچکنا
فِعل لازِم
مُتردّد ہونا۔ غور و تامل کرنا۔ ہچکچانا۔ متفکر ہونا۔ اندیشہ ہونا۔سچّی
اِسم مُؤنّث
راستباز۔ صادقہ۔ ٹھیک۔ واقعی۔ بجا۔ کھری۔ خالص۔ نِرمل۔ بے کھوٹ۔سچی تول
اِسم مُؤنّث
پُوری تول۔سچی چوڑیاں
اِسم مُؤنّث
دیکھو ( سچا جوڑا)۔سِڈول
صِفت
دیکھو ( سُڈول)۔ 
***
سُڈول
صِفت
متناسب۔ باہم تناسب رکھنے والا۔ اچھے ڈول کا۔ خوبصورت۔ موزوں۔ زیبا۔ خوش قطع۔سڈھور
اِسمِ مُذکّر
وہ سات طرح کا پکوان جو ستوانسے میں دُلہن کے میکے کی طرف سے تلا جاتا  یا میکے سے میوے اور است قسم کی ترکاریوں سمیت آتا ہے۔ اسے سب بیٹھ کر کھاتے ہیں۔ اور دُلہن کی گود ترکاریوں وغیرہ سے بھری جاتی ہے۔سِڑ
اِسم مُؤنّث
جنون۔ دیوانگی۔ خفقان۔ پگلا پن۔ باؤلا پن۔ کولا۔ سودائی۔ احمق۔ چُوتیا۔ مودھو۔ ماٹھو۔سُڑ سُڑ
تابع فِعل
حقہ پینے کی آواز۔ حُقہ کی آواز۔سِڑ چھوٹنا
فِعل لازِم
سودا اُچھلنا۔ جنون ہونا۔ خبط ہونا۔سَڑا
صِفت
بُسا۔ تُرش شُدہ۔ گلا۔ بوسیدہ۔ خراب۔ بگڑا ہؤا۔سڑانا
فعل مُتعدّی
خمیر اُٹھانا۔ بُو پیدا کرنا۔ مُتعفن کرنا۔ گلانا۔ بوسیدہ کرنا۔ رکھ چھوڑنا۔سڑانڈ
اِسم مُؤنّث
بُو۔ مُتعفن۔ تخمریزی کا بیج۔سڑانڈ اُٹھنا
فِعل لازِم
بد بو آنا۔ تُعفّن پیدا ہونا۔ سڑ جانا۔سڑانڈا
صِفت
بدبو دار۔ سڑا ہؤا۔ گندا۔ ناکارہ۔ خراب۔سڑاک
اِسم مُؤنّث
قمچی یا چابک کی آواز۔سڑاک سے
تابع فِعل
جلدی سے آواز کے ساتھ۔سِڑن
اِسم مُؤنّث
دیوانی۔ باؤلی۔ سوداین۔ احمق۔ بیوقوف۔سڑپ
اِسم مُؤنّث
کِسی رقیق چیز کے پینے یا جلد جلد کھانے کی آواز۔ کش۔ چُسکی۔سڑپّا
اِسمِ مُذکّر
کش۔ ایک دفعہ ہی پی جانے کی آواز۔ چُسکا۔سڑپنا
فِعل لازِم
پینا۔ کش کھینچنا۔ سُڑکنا۔ چُسکی لگانا۔سَڑک
اِسم مُؤنّث
راجمارگ۔ شاہراہ۔ شاہی رستہ۔ رستہ۔ راہ۔ ڈگر۔ 
***
سُڑک
صِفت
جلدی۔ شتابی۔ فوراً۔سڑک پھانسی
اِسم مُؤنّث
پھانسا۔ کھرک پھانسی۔سڑک کاٹنا
فعل مُتعدّی
سڑک نکالنا۔ نئی سڑک یا رستہ جاری کرنا۔ جیلخانہ کی سزا پانا۔ قید بُھگتنا۔سُڑکنا
فعل مُتعدّی
نگلجانا۔ پورب میں تلوار میان سے سوتنے کو بھی کہتے ہیں۔سُڑکی
اِسم مُؤنّث
کنکوّے کی ڈور کا دفعتہً چھوڑ کر ڈھیلی دینا۔ چھپکا دینا۔سِڑی
اِسمِ مُذکّر
پاگل۔ مجنون۔ دیوانہ۔ باؤلا۔ خبطی۔ بیوقوف۔ احمق۔سَڑیل
صِفت
غلیظ۔ ناکارہ۔ بوسیدہ۔ خراب۔ عیب دار۔سَکار
اِسم مُؤنّث
بھور۔ پو پھٹے۔ علی الصباح۔ تڑکا۔سکارا
اِسمِ مُذکّر
وہ فیس جو ہُنڈی کی بابت دی جائے۔سکارنا
فعل مُتعدّی
قبول کرنا۔ ماننا۔ تسلیم کرنا۔ آیا کرنا۔ ذمہ لینا۔ ہُنڈی کا روپیہ ادا کرنا۔سکارے
اِسمِ مُذکّر
سویرے۔ صبح۔ تڑکے۔ پو پٹے۔ کل۔ آج کے دوسرے دن۔سکالر شِپ
اِسم مُؤنّث
وظیفہ۔ طالب علمی کا وظیفہ۔سُکّان
اِسمِ مُذکّر
پتوار۔ دنبالہ کشتی۔سَکت
اِسم مُؤنّث
دم۔ طاقت۔ سامرتھ۔ بُوتا۔ توانائی،۔سکتّر
اِسمِ مُذکّر
سکرٹری۔ میر منشی۔ دیوان۔ مستری۔ مصاحب۔ پیشکار۔سَکتہ
اِسمِ مُذکّر
ایک دماغی مرض کا نام جس میں حس و حرکت زائل ہو کر آدمی مردے کی مانند ہو جاتا ہے۔ مرضِ  بیہوشی۔ مِرگی۔ غشی۔سکتہ پڑنا
فِعل لازِم
شعر کی روانی میں فرق آنا۔ شعر ٹوٹنا۔سکتہ کا عالم
تابع فِعل
حیرت کا مقام۔ بے خبری اور بیہوشی کی نوبت۔ خاموشی کا عالم۔سکتہ ہونا
فِعل لازِم
مور چھاگت میں آنا۔ بیہوش ہو جانا۔ غش آ جانا۔ شعر ٹوٹنا۔ حیرت ہونا۔سَکّر
اِسم مُؤنّث
شکّر۔ چینی۔ کھانڈ۔ 
***
سُکّر
اِسمِ مُذکّر
زہرہ۔ ناہید۔ ایک ستارہ کا نام جو نہایت تاباں ہے۔ جمعہ۔ شُکردار۔ 
***
سُکر
اِسمِ مُذکّر
مستی۔ خُمار۔ منشہ۔ بے ہوشی۔سکرات
اِسم مُؤنّث
موت کی شدت اور سختی ۔ جانکنی کی تکلیف۔ بیہوشیاں۔سکرانت
اِسم مُؤنّث
تحویلِ آفتاب۔ سورج کا ایک بُرج سے دوسرے بُرج میں جانا۔سِکرنا
فِعل لازِم
جمع ہونا۔ اکٹھا ہونا۔ سمٹنا۔سِکشا
اِسم مُؤنّث
تعلیم۔ تربیت۔ تادیب۔ سکھانا۔ نصیحت۔ پند۔ وید کے ایک حصہ کا نام ۔سَکل
صِفت
سگرا۔ سارا۔ تمام۔ کُل۔ ہر ایک۔سِکنا
فِعل لازِم
بُھنّا۔ پُختہ ہونا۔ پک کر کرارا ہونا۔ کھڑنک ہونا۔ تپنا۔ گرم ہونا۔ 
***
سَکنا
فِعل لازِم
لائق ہونا۔ قابل ہونا۔ مُمکن ہونا۔ جوگا ہونا۔سِکندر

رومی زبان میں لہسن کو اور یونانی زبان میں محافظ کو کہتے ہیں۔سِکندری
صِفت
منسوب بہ سکندر جیسے سدِّ سکندری۔ ۔ گھوڑے کی ٹھوکر۔سِکندری کھانا
فعل مُتعدّی
گھوڑے کا ٹھوکر کھانا۔ گھوڑے کا گِرنا۔سِکندریہ
اِسمِ مُذکّر
مصر کے یاک مشہور شہر کا نام جس کو سکندر رومی نے بنایا تھا۔سِکنڈ
اِسمِ مُذکّر
لمحہ۔ منٹ کا ساٹھواں حصہ۔ پل۔ دوسرا۔ دوجا۔ ثانی۔سِکّو
اِسمِ مُذکّر
قصاب آپس میں ایک دوسرے کو کہتے ہیں۔ چُھری بند بھائی۔سِکوان
اِسمِ مُذکّر
بیمار آدمی۔ مریض۔ ماندہ۔سُکُوت
اِسمِ مُذکّر
خاموشی۔ چُپ۔سُکوت کرنا
فعل مُتعدّی
خاموش رہنا۔ چُپ رہنا۔ ٹھیرنا۔سُکورہ
اِسمِ مُذکّر
مٹی کا پیالہ۔ مٹی کی چینی۔سِکوری
اِسم مُؤنّث
مٹی کی پیالی۔سُکُون
اِسمِ مُذکّر
آرام ۔ قیام ۔ ٹھیراؤ۔ قرار۔ اطمینان۔ آسودگی۔ حرفِ ساکن کی مقررہ علامت۔سُکُونت
